<Project>

  <!-- Общие свойства решения. Без этого файл заменил бы корневой, а не дополнил. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      CA1707 — «уберите подчёркивания из имени члена». В продукте правило
      остаётся, в тестах снимается: подчёркивание разделяет «что проверяем» и
      «чего ждём», и имя теста читается фразой, а не идентификатором. Список
      падений в CI — это первое, что видит человек, и читаться он должен
      без расшифровки.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
