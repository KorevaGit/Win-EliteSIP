<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DPAPI. Проект остаётся `net10.0`, а не `net10.0-windows`: платформенный
      здесь один тип из пяти, и у него две половины — DPAPI на Windows и
      AES-GCM с ключом в профиле на Linux и macOS (ProtectedSecret.Unix.cs).
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Проверкам нужен свой каталог ключа: настоящий профиль они не трогают. -->
    <InternalsVisibleTo Include="EliteSIP.AdminAccess.Tests" />
  </ItemGroup>

</Project>
