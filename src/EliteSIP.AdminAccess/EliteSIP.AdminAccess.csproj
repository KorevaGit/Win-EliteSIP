<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DPAPI. Проект остаётся `net10.0`, а не `net10.0-windows`: платформенный
      здесь один тип из пяти, и он помечен `SupportedOSPlatform`. Сборка под
      Windows и без того единственная целевая, а `net10.0` позволяет прогонять
      тесты пароля где угодно.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

</Project>
