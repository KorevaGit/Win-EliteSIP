<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Системного SQLite в Windows нет — в оригинале брали тот, что в macOS уже
      лежит. `Microsoft.Data.Sqlite` едет с приложением вместе с нативной
      библиотекой; это и было решением плана на этапе W7.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
