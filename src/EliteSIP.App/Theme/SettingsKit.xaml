<!--
    Вид кирпичей настроек. Устройство и доводы — в SettingsKit.cs.

    Шкала отступов одна на всё окно, и чисел в ней три (11 сентября 2026):

      6  — пояснение под своим управлением: оно часть того, над чем стоит;
      12 — между соседними пунктами одной группы;
      32 — между группами.

    Прежде каждый кирпич нёс свои поля (3, 4, 6, 10, 18), и они складывались
    как придётся: что-то стояло впритык, что-то с дырой. Здесь поле есть
    только снизу, и промежуток между любыми двумя пунктами — одно из трёх чисел.

    Несвязанное разделяется группой с заголовком, а не чертой: черта между
    «Собрать логи» и «Проверить обновления» говорила «здесь граница», но не
    говорила, чего.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:EliteSIP.App.Theme"
                    xmlns:res="clr-namespace:EliteSIP.App.Resources">

  <!--
      Группа: заголовок и пункты под ним. Без плашки — Параметры Windows 10
      кладут пункты прямо на фон страницы и отделяют группы воздухом.
  -->
  <Style TargetType="{x:Type theme:SettingsSection}">
    <Setter Property="Margin" Value="0,0,0,32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:SettingsSection}">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Header}"
                       Margin="0,0,0,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ItemsPresenter />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Подпись над управлением, обе от левого края — как в Параметрах
      Windows 10. Прежняя колонка подписей, прижатых вправо, — раскладка
      macOS, и на Windows она читалась как текст с середины окна.
  -->
  <Style TargetType="{x:Type theme:SettingsRow}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:SettingsRow}">
          <StackPanel>
            <TextBlock x:Name="Header"
                       Text="{TemplateBinding Header}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <!--
                Управление шире 360 не растёт: поле во всю ширину окна
                читается хуже короткого, а вводят в него добавочный из трёх
                цифр.
            -->
            <ContentPresenter MaxWidth="360"
                              MinWidth="240"
                              HorizontalAlignment="Left" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <!-- Пустая подпись не оставляет по себе пустой строки. -->
            <Trigger Property="Header" Value="">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Всё, у чего нет своей подписи: кнопки, ряды кнопок. -->
  <Style TargetType="{x:Type theme:SettingsIndented}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:SettingsIndented}">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Пояснение. Стоит под тем, что поясняет, и прижато к нему: отрицательное
      поле сверху съедает 6 из 12, оставленных пунктом выше. Так пояснение
      читается частью своего управления, а не отдельным пунктом.
  -->
  <Style TargetType="{x:Type theme:SettingsNote}">
    <Setter Property="Margin" Value="0,-6,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:SettingsNote}">
          <TextBlock x:Name="Body"
                     Text="{TemplateBinding Text}"
                     FontSize="12"
                     MaxWidth="420"
                     HorizontalAlignment="Left"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsAlarming" Value="True">
              <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource StatusFailureBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Черта. Оставлена для «Управления»; в настройках группы делят заголовки. -->
  <Style TargetType="{x:Type theme:SettingsDivider}">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:SettingsDivider}">
          <Border Height="1" Background="{DynamicResource SeparatorBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Переключатель Параметров Windows 10: название настройки строкой выше,
      под ним сам переключатель и справа от него «Вкл.» или «Откл.».

      Прежде была пилюля у правого края строки, затем пилюля с названием
      справа — оба варианта читались как macOS. В Windows 10 состояние
      переключателя подписано словом: по одному цвету пилюли его понимают
      не все.
  -->
  <Style x:Key="SettingsSwitchStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Background="Transparent">
            <ContentPresenter Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal">
              <!-- 40×20, обводка 2 и бегунок 10 — размеры системного. -->
              <Border x:Name="Track"
                      Width="40"
                      Height="20"
                      CornerRadius="10"
                      VerticalAlignment="Center"
                      BorderThickness="2"
                      BorderBrush="{DynamicResource TextPrimaryBrush}"
                      Background="Transparent">
                <Ellipse x:Name="Knob"
                         Width="10"
                         Height="10"
                         Margin="3,0,0,0"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource TextPrimaryBrush}" />
              </Border>

              <TextBlock x:Name="State"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Text="{res:Loc SwitchOff}" />
            </StackPanel>
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
              <Setter TargetName="Knob" Property="Fill" Value="White" />
              <Setter TargetName="State" Property="Text" Value="{res:Loc SwitchOn}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Кнопка Windows 10 (акцентных в этом окне нет — ни одно менеджерское
      действие не главное на странице): плоский серый прямоугольник, под курсором проявляется
      рамка, под нажатием заливка светлеет.
  -->
  <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  BorderThickness="2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Плитка темы: превью окна и подпись под ним — как в «Персонализации»
      Windows. Тема выбирается глазами, а не словом: до 0.1.59 её
      переключатель выглядел так же, как выбор языка рядом, и их путали.
      Tag задаёт превью: Light, Dark или System (половина светлая, половина
      тёмная). Цвета превью фиксированы: они показывают тему, а не
      оформление текущей.
  -->
  <Style x:Key="ThemeTileStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Background="Transparent">
            <Border x:Name="Frame"
                    Width="104" Height="68"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource ControlBorderHoverBrush}"
                    Padding="2">
              <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="DarkHalf" Width="0" />
                </Grid.ColumnDefinitions>
                <!-- Светлая (или левая) половина. -->
                <Border x:Name="Left" Background="#FFF3F3F3" CornerRadius="3">
                  <StackPanel Margin="8,8,8,0">
                    <Border x:Name="LeftBar" Height="6" CornerRadius="2" Background="#FFD0D0D0" />
                    <Border x:Name="LeftAccent" Height="12" Width="36" Margin="0,8,0,0" CornerRadius="2"
                            HorizontalAlignment="Left" Background="{DynamicResource AccentFillBrush}" />
                  </StackPanel>
                </Border>
                <!-- Тёмная половина — только у «Как в системе». -->
                <Border Grid.Column="1" Background="#FF202020" CornerRadius="0,3,3,0">
                  <StackPanel Margin="8,8,8,0">
                    <Border Height="6" CornerRadius="2" Background="#FF454545" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <ContentPresenter Margin="0,6,0,0" HorizontalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Dark">
              <Setter TargetName="Left" Property="Background" Value="#FF202020" />
              <Setter TargetName="LeftBar" Property="Background" Value="#FF454545" />
            </Trigger>
            <Trigger Property="Tag" Value="System">
              <Setter TargetName="DarkHalf" Property="Width" Value="*" />
              <Setter TargetName="Left" Property="CornerRadius" Value="3,0,0,3" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Выбор одного из нескольких — радиокнопками Windows: кружок и подпись.

      До 0.1.59 здесь был сегментированный переключатель из макета macOS
      (сплошная плашка с залитым выбранным сегментом). На Windows он читался
      чужеродно, и все такие переключатели выглядели одинаково: тема и язык
      в «Оформлении» были неотличимы. Имя стиля оставлено прежним — им
      пользуются полтора десятка мест, и каждое из них остаётся переключателем.
  -->
  <Style x:Key="SegmentStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,18,0" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="Transparent" MinHeight="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse x:Name="Ring"
                       Stroke="{DynamicResource TextSecondaryBrush}"
                       StrokeThickness="1"
                       Fill="Transparent" />
              <Ellipse x:Name="Dot"
                       Width="8" Height="8"
                       Fill="White"
                       Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentFillBrush}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillBrush}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Ползунок Параметров Windows 10: тонкая дорожка, пройденная часть и
      бегунок — акцентным цветом, остаток — серым.

      Прежде своего стиля не было вовсе, и рисовался ползунок Aero со
      светлым бегунком — единственное на странице, что оставалось системным
      цветом, а не цветом оформления.
  -->
  <Style x:Key="SettingsSliderRepeatStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <!-- Прозрачная полоса во всю высоту: по ней щёлкают, чтобы
               перескочить, и тонкая дорожка одна была бы мишенью в 2 точки. -->
          <Grid Background="Transparent">
            <Border Height="2" Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SettingsSliderRepeatStyle}"
                            Background="{DynamicResource AccentFillBrush}"
                            Command="Slider.DecreaseLarge" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SettingsSliderRepeatStyle}"
                            Background="{DynamicResource ControlPressedBrush}"
                            Command="Slider.IncreaseLarge" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <!-- Прямоугольный бегунок 8×24 — ползунок Windows 10;
                         скруглённая капсула читалась как macOS. -->
                    <Border x:Name="Knob"
                            Width="8"
                            Height="24"
                            CornerRadius="2"
                            Background="{DynamicResource AccentFillBrush}" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Knob" Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Обойма сегментов: общая подложка, по которой ездит выбранный. -->
  <Style x:Key="SegmentGroupStyle" TargetType="{x:Type ItemsControl}">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

</ResourceDictionary>
