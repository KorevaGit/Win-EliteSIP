<!--
    Тёмная палитра. Ключи те же, что в светлой, — почему, сказано там же.

    Цвета состояния здесь не те же самые, а осветлённые: на тёмном фоне
    #FF0F7B0F уходит в чёрно-зелёное пятно, а точка состояния — это восемь
    точек экрана, единственное, чем показано обычное состояние регистрации.
    Числа — из палитры Windows 11 для тёмной темы, а не подобранные на глаз.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />

  <!-- Фон и боковая полоса — числа Параметров Windows 10: чёрный контент и
       тёмно-серый список разделов. Прежние #202020/#2C2C2C — Windows 11. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF333333" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF454545" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF666666" />
  <SolidColorBrush x:Key="SeparatorBrush" Color="#18FFFFFF" />

  <!-- Обводка кнопки или поля. Зачем она — сказано в светлой палитре. -->
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#00000000" />
  <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#FF858585" />

  <!-- Полоса прокрутки. Зачем ползунок так заметен — в светлой палитре. -->
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8AFFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0FFFFFFF" />
  <!--
      Синий приложения. Тот же цвет Windows, что и в светлой палитре, но её
      осветлённый вариант: #4CC2FF — это и есть системный #0078D4, каким его
      показывает тёмная тема. Прежний #60CDFF был на ступень светлее и на
      тёмном фоне читался бледно-голубым, а не синим.
  -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#4C4CC2FF" />
  <SolidColorBrush x:Key="AccentFillBrush" Color="#FF0078D7" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#FF2B2B2B" />

  <SolidColorBrush x:Key="StatusRegisteredBrush" Color="#FF6CCB5F" />
  <SolidColorBrush x:Key="StatusConnectingBrush" Color="#FFFCA02E" />
  <SolidColorBrush x:Key="StatusOfflineBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="StatusFailureBrush" Color="#FFFF99A4" />
  <SolidColorBrush x:Key="StatusInCallBrush" Color="#FF4CC2FF" />

  <!--
      Заливка кнопок звонка одна на обе палитры и не осветляется: под ней
      белая надпись, и светлая заливка тёмной темы делала бы «Завершить»
      нечитаемой. Осветлены только цвета надписей — см. светлую палитру.
  -->
  <SolidColorBrush x:Key="AnswerBrush" Color="#FF6CCB5F" />
  <SolidColorBrush x:Key="DeclineBrush" Color="#FFFF99A4" />
  <SolidColorBrush x:Key="AnswerFillBrush" Color="#FF107C10" />
  <SolidColorBrush x:Key="DeclineFillBrush" Color="#FFC42B1C" />

  <SolidColorBrush x:Key="OutcomeCompletedBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="OutcomeAnsweredBrush" Color="#FF6CCB5F" />
  <SolidColorBrush x:Key="OutcomeUnreachableBrush" Color="#FFFCA02E" />
  <SolidColorBrush x:Key="OutcomeMissedBrush" Color="#FFFF99A4" />

  <SolidColorBrush x:Key="CautionBrush" Color="#FFFCA02E" />
  <SolidColorBrush x:Key="UnsavedBrush" Color="#FFFCA02E" />

</ResourceDictionary>
