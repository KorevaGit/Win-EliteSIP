<!--
    Общие стили. Здесь только то, чем пользуется больше одного окна; вёрстка
    конкретного окна живёт рядом с ним.

    Системными стилями кнопок и полей панель не пользуется вовсе, и это то же
    решение, что в оригинале: у системной кнопки свой радиус, своя рамка и своя
    высота, и в окне шириной 270 точек, собранном по макету, она выпадает.
    Плюс своя высота у системного стиля означает, что кнопка растягивает не
    себя, а ряд, в котором стоит, — а в панели заперты все ярусы.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:theme="clr-namespace:EliteSIP.App.Theme">

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <theme:InverseBooleanToVisibilityConverter x:Key="NotBoolToVisibility" />
  <theme:PresenceToVisibilityConverter x:Key="PresenceToVisibility" />
  <theme:InverseBooleanConverter x:Key="NotBool" />
  <theme:PercentConverter x:Key="Percent" />
  <theme:EnumToBoolConverter x:Key="EnumToBool" />

  <!-- Непрозрачность выключенного элемента: одна на всё приложение. -->
  <sys:Double x:Key="DisabledOpacity">0.57</sys:Double>

  <!--
      Значок. Шаблон один на все тридцать четыре: фигура приезжает ресурсом по
      имени, размер задаёт `Size`, цвет наследуется от `Foreground`.

      `Viewbox` вместо масштаба у самой фигуры — потому что фигуры нарисованы на
      сетке 20×20 и в вёрстке стоят кеглями 10, 12, 14. Считать масштаб по месту
      значило бы записать 20 в тридцать четыре места.
  -->
  <Style TargetType="{x:Type theme:Icon}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type theme:Icon}">
          <Viewbox Width="{TemplateBinding Size}"
                   Height="{TemplateBinding Size}"
                   Stretch="Uniform">
            <ContentPresenter Content="{TemplateBinding Shape}" />
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Радиус скругления — один на все поверхности управления, и число взято не
      на глаз: 4 — это `ControlCornerRadius` самой Windows 11, тот же, что у
      системной кнопки, поля и строки списка. Прежняя восьмёрка была
      пересчётом macOS, где радиус крупнее по всей системе; на клавише в 32
      точки высотой она заметно круглее соседних системных окон, а на капсуле
      профиля — наоборот, недостаточно кругла. Капсула поэтому и осталась
      единственным исключением: 11 при высоте 22 — это не скругление, а форма,
      и означает она метку состояния, а не кнопку.
  -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

  <!--
      Кнопка-поверхность: подложка, скругление, подсветка под курсором.
      Основание для всего, что в панели нажимается, кроме звонка — у того своя
      заливка цветом действия.

      Область нажатия — весь прямоугольник кнопки, а не только подпись внутри.
      В оригинале это пришлось чинить отдельно (`contentShape`): подсветка
      занимала все 22 точки, а щёлкать приходилось по значку в 12, и промах
      читался как «шестерёнка сломалась». В WPF так по умолчанию — лишь бы фон
      не был `null`, поэтому он `Transparent`, а не пустой.
  -->
  <Style x:Key="SurfaceButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Label"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <!--
                Под нажатием гаснет не только заливка, но и подпись: в
                Windows 11 нажатие показано именно этой парой, и одной
                заливкой оно читается вяло — светлая нажатая поверхность
                отличается от спокойной слабее, чем тёмная.
            -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
              <Setter TargetName="Label" Property="Opacity" Value="0.75" />
            </Trigger>
            <!--
                Выключенная кнопка гаснет, но остаётся видимой: три почти
                невидимые кнопки читаются как сломанные, а не как «пока нечем
                пользоваться».
            -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Кнопка-значок без подложки: шестерёнка в строке состояния, крестик в поле
      набора. Полоса заголовка теперь системная, и своих кнопок окна в панели
      не осталось — но стиль сохранил имя, потому что осталось само поведение:
      кнопка, у которой в покое нет ни заливки, ни края, и оба появляются под
      курсором.

      Обводки нет намеренно: край вокруг значка размером 12 точек превращает
      его в клавишу, которой он не является.
  -->
  <Style x:Key="ChromeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SurfaceButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <!--
      Капсула профиля. Кнопка со списком, и единственное в приложении, что
      скруглено в капсулу: при высоте 22 радиус 11 — это уже не скругление, а
      форма, и означает она метку состояния, каковой капсула наполовину и
      является.

      Выключенная (в разговоре) не гаснет целиком, как прочие кнопки, — оттого
      у шаблона и нет отклика на `IsEnabled`: номер и точка состояния обязаны
      читаться в разговоре в полную силу. Пропадает один шеврон, и убирает его
      разметка панели: капсула, которая не открывается, не должна и обещать,
      что откроется.
  -->
  <Style x:Key="ProfilePillStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SurfaceButtonStyle}">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="11"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Кнопка ряда управления: удержание, микрофон, перевод, конференция.
      Включённая (удержание стоит, микрофон выключен) заливается цветом
      предупреждения — это состояние, а не выбор, и о нём надо помнить.
  -->
  <Style x:Key="ControlKeyStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
              <Setter TargetName="Label" Property="Opacity" Value="0.75" />
            </Trigger>
            <!--
                Залитая клавиша обводки не носит: край на цветной заливке
                читается как ободок вокруг цвета, а не как край кнопки.
            -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource StatusConnectingBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="Transparent" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Клавиша макроса. Высота задаётся кнопке, а не подписи внутри неё: поле
      системного стиля по версиям разное, и ряды клавиш от него разъезжаются.
      Здесь стиль свой и поля у него нет вовсе — но правило то же, потому что
      ряды сетки обязаны быть одинаковыми.
  -->
  <Style x:Key="MacroKeyStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SurfaceButtonStyle}" />

  <!--
      Кнопка подтверждения в вопросе: «Сменить», «Сохранить», «Снять».
      Заливка акцентом, надпись белая — так в Windows 11 отмечена та кнопка,
      которую нажмут в девяти случаях из десяти.

      Белым по акценту, а не по правилам палитры: акцент в обеих палитрах —
      цвет с достаточной насыщенностью, и белая надпись читается на нём и в
      светлой, и в тёмной.
  -->
  <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SurfaceButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Кнопка звонка. Заливка задана явно, а не акцентом системы: в неактивном
      окне системный акцент выцветает в серый, а панель висит поверх CRM и
      активной бывает редко.
  -->
  <Style x:Key="CallButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource AnswerFillBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
            </Trigger>
            <!--
                Нажатие гасит сильнее наведения — тем же шагом, каким это
                сделано у поверхностей: 0.88 под курсором, 0.75 под пальцем.
            -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
            </Trigger>
            <!--
                Выключенная гаснет сильнее прочих — до 0.4, как в оригинале:
                ярко-зелёная «Позвонить» иначе выглядит рабочей, хотя ещё нет.
            -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Поле ввода панели. Своё по той же причине, что и кнопки: у системного
      своя рамка и свой радиус, и рядом с нашими поверхностями оно читается как
      чужое. Плюс подсказка — её у `TextBox` нет вовсе.
  -->
  <Style x:Key="PanelTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            <TextBlock x:Name="Placeholder"
                       Text="{TemplateBinding Tag}"
                       Margin="2,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsFocused" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      ==================== Полоса прокрутки ====================

      Своя по той же причине, что кнопки и списки, но с одной добавкой: у
      системной полосы WPF вид не Windows 11, а Windows 7 — серый жёлоб во всю
      высоту, кнопки-стрелки на концах и ползунок с рамкой. Ни кнопок, ни жёлоба
      в Windows 11 нет вовсе.

      Устроена она там так: в покое — волосок вдоль края, под курсором —
      полоса вчетверо шире с ползунком поверх подложки. Ширину меняет сама
      полоса, а не её содержимое, поэтому текст под ней не перекладывается.
  -->

  <!-- Ползунок: скруглённая пилюля, темнеющая под курсором. -->
  <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <!--
              Прозрачная подложка во всю ширину полосы, а сам ползунок внутри
              неё: тянуть надо за всю ширину, а видеть — только пилюлю.
          -->
          <Border Background="Transparent" Padding="4,0">
            <Border x:Name="Pill"
                    CornerRadius="3"
                    Background="{DynamicResource ScrollThumbBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Щелчок мимо ползунка листает страницу. Кнопка невидима и в покое, и под
      курсором: в Windows 11 у жёлоба нет своего вида вовсе.
  -->
  <Style x:Key="ScrollPageStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <!--
              Подложка появляется под курсором и в покое прозрачна: полоса
              лежит поверх содержимого, и постоянный жёлоб рисовал бы серую
              черту вдоль каждого списка.
          -->
          <Border x:Name="Track"
                  Background="Transparent"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <!--
          Лежачая полоса — тот же шаблон, повёрнутый на бок. Отдельным
          шаблоном она разошлась бы с вертикальной при первой же правке, а
          нужна она в приложении один раз — под широкой таблицей истории.
      -->
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Border x:Name="Track"
                      Background="Transparent"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}">
                      <Thumb.LayoutTransform>
                        <RotateTransform Angle="90" />
                      </Thumb.LayoutTransform>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
      ==================== Выпадающие списки и меню ====================

      Своё, а не системное, и по той же причине, по какой свои кнопки и поля:
      системный список приходит со своей рамкой, своим радиусом и своей
      подсветкой — той, что рисовал ещё Windows 7, — и рядом с нашими
      поверхностями читается как чужой. Внутри окна, собранного по макету, это
      видно первым.

      Общего у списка и меню больше, чем различий: обе всплывающие поверхности
      подчиняются одним правилам — восьмёрка радиуса (`OverlayCornerRadius`
      Windows 11, а не четвёрка контролов: всплывающее крупнее и скруглено
      сильнее), край, тень и поле в 4 точки вокруг строк.
  -->

  <!-- Радиус всплывающей поверхности: списка, меню, подсказки. -->
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

  <!--
      Тень под всплывающим. Слабая и глубокая: всплывающее в Windows 11 не
      висит над окном стопкой, а лежит на нём — тень здесь отделяет край, а не
      изображает высоту.
  -->
  <DropShadowEffect x:Key="OverlayShadow"
                    BlurRadius="14"
                    ShadowDepth="2"
                    Direction="270"
                    Opacity="0.22"
                    Color="Black" />

  <!--
      Поверхность всплывающего. Один шаблон на список и на меню — иначе они
      разъедутся, а стоят они в одном окне и открываются одним и тем же
      движением.
  -->
  <ControlTemplate x:Key="OverlaySurfaceTemplate" TargetType="{x:Type ContentControl}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Padding="4"
            SnapsToDevicePixels="True">
      <ContentPresenter />
    </Border>
  </ControlTemplate>

  <!--
      Строки списка и меню высотой 32 — той же, что у клавиши ряда управления:
      это одна и та же величина «строка, в которую целятся мышью».

      Место под галочку в них занято всегда, и у невыбранных строк тоже. Иначе
      выбранная строка съезжала бы вправо относительно прочих, и список
      подрагивал бы при каждой смене выбора.
  -->

  <!--
      Список выбора устройства. Кнопка-поверхность с шевроном справа, под ней
      всплывающая поверхность со строками.
  -->
  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <!--
                Раскрывает список весь прямоугольник, а не один шеврон: в
                системном списке так же, и промах по шеврону читался бы как
                «список сломался».
            -->
            <ToggleButton x:Name="Surface"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border x:Name="Fill"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          SnapsToDevicePixels="True" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fill" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Fill" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <Grid Margin="10,0,8,0" IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ContentPresenter Grid.Column="0"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                VerticalAlignment="Center" />

              <theme:Icon Grid.Column="1"
                          Glyph="chevron.down"
                          Size="12"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   VerticalOffset="4"
                   PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <!--
                  Поле вокруг поверхности — место под тень: тень рисуется за
                  краем окна всплывающего, и без поля её обрезает.
              -->
              <ContentControl Margin="8"
                              MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}"
                              Effect="{StaticResource OverlayShadow}"
                              Template="{StaticResource OverlaySurfaceTemplate}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </ContentControl>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Строка списка. Галочка слева, подсветка под курсором. -->
  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="Row"
                  Height="32"
                  Background="Transparent"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <Grid Margin="8,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <theme:Icon x:Name="Tick"
                          Grid.Column="0"
                          Glyph="checkmark"
                          Size="13"
                          VerticalAlignment="Center"
                          Visibility="Hidden"
                          Foreground="{DynamicResource TextPrimaryBrush}" />

              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Меню. Тем же шаблоном, что и список: меню профиля открывается из панели,
      меню значка — из области уведомлений, и оба обязаны выглядеть одним
      предметом.
  -->
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <ContentControl Margin="8"
                          Effect="{StaticResource OverlayShadow}"
                          Template="{StaticResource OverlaySurfaceTemplate}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="Row"
                  Height="32"
                  MinWidth="160"
                  Background="Transparent"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <Grid Margin="8,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <theme:Icon x:Name="Tick"
                          Grid.Column="0"
                          Glyph="checkmark"
                          Size="13"
                          VerticalAlignment="Center"
                          Visibility="Hidden"
                          Foreground="{DynamicResource TextPrimaryBrush}" />

              <ContentPresenter Grid.Column="1"
                                ContentSource="Header"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <!--
                Погашенная строка не подсвечивается вовсе: подсветка под
                курсором на строке, которая не нажимается, обещает то, чего
                не будет. Первая строка меню значка — как раз такая: это
                состояние словами, а не действие.
            -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
              <Setter TargetName="Row" Property="Background" Value="Transparent" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      Разделитель меню: волосок с воздухом сверху и снизу.

      Ключ, а не тип: разделитель внутри меню WPF берёт стиль по
      `MenuItem.SeparatorStyleKey`, и стиль, объявленный на `Separator`, до него
      не доходит вовсе — меню так и осталось с системной белой чертой во всю
      ширину, что живая проверка и показала.
  -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4,8,4" />
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
