<Window x:Class="EliteSIP.App.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:panel="clr-namespace:EliteSIP.App.Panel"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=panel:PanelViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="270"
        MinWidth="270"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{DynamicResource PanelWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

  <!--
      Содержимое определяет минимальную высоту окна. При первом показе код
      задаёт вытянутую форму 4:3, как в Linux-клиенте; размер оператора
      восстанавливается при следующих запусках.

      Плата за это — в code-behind: растущее окно Windows тянет вниз, оставляя
      на месте верхний край, а неподвижным в панели обязан быть нижний.
  -->

  <!-- Windows 11 использует штатный заголовок с цветом DWM; Windows 10 — общий фон и свой заголовок. -->

  <!--
      Поля 12 со всех сторон и шаг сетки, кратный четырём: это тот же ритм, по
      которому набраны системные окна Windows 11. Прежние 5 и 15 между рядами
      были пересчётом macOS-овских отступов и в общий шаг не ложились.
  -->
  <!--
      Панель тянется за край (11 сентября 2026).

      С 0.1.60 растягивание увеличивает только горячие клавиши: окно тянут
      ради них (29 сентября 2026, владелец). Масштаба всего окна больше нет —
      он растил и поле номера, и «Позвонить», а клавишам доставалась та же
      доля. Лишняя высота уходит сетке клавиш; без клавиш — кнопкам
      управления, чтобы не оставалось пустоты. Выше экрана окно не бывает:
      не влезает — клавиши ниже (см. `FitMacroHeight`).
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Graphite.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
              <theme:CaptionCrown FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{TemplateBinding Title}" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="{res:Loc WindowMinimize}" AutomationProperties.Name="{res:Loc WindowMinimize}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10" /></Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMaximizeClick" ToolTip="{res:Loc WindowMaximize}" AutomationProperties.Name="{res:Loc WindowMaximize}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Tag="Close" Click="OnCaptionCloseClick" ToolTip="{res:Loc WindowClose}" AutomationProperties.Name="{res:Loc WindowClose}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10" /></Button>
            </StackPanel>
          </Grid>
          <AdornerDecorator><ContentPresenter /></AdornerDecorator>
        </DockPanel>
      </Border>
    </ControlTemplate>
  </Window.Template>


  <Border x:Name="Frame">
  <Grid x:Name="Root" Margin="8">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <!-- Строка состояния. -->
      <RowDefinition Height="22" />
      <RowDefinition Height="8" />
      <!--
          Изменчивая середина. Всё, что может поменять высоту — вторая линия,
          поле перевода, число макросов, — живёт здесь.
      -->
      <RowDefinition Height="5*" />
      <RowDefinition Height="8" />
      <!-- Неподвижный низ: звонок и история. С 0.1.60 от окна не растёт —
           лишняя высота вся уходит клавишам. -->
      <RowDefinition Height="62" />
    </Grid.RowDefinitions>

    <!--
        Строка состояния: капсула профиля слева, слот беды посередине,
        шестерёнка справа. Крайние слоты не меняют размер никогда, средний
        тянется и обрезается — иначе капсула ездила бы от длины чужой надписи.
    -->
    <Grid Grid.Row="0" SizeChanged="OnStatusRowSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="72" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--
          Капсула профиля: точка состояния, номер, пометка, шеврон.
          Состояние и профиль в одном месте намеренно — это один вопрос,
          «кто я и на линии ли я», а не два.

          И это кнопка со списком, а не подпись. В оригинале так и было, а
          порт до этого оставил от неё одну плашку — из-за чего уйти с линии
          можно было только из меню значка в области уведомлений, то есть
          свернув панель, которая для этого и открыта.

          В разговоре не нажимается: смена профиля и отключение снимают
          регистрацию и оборвали бы разговор. Гаснет при этом один шеврон —
          номер и точка обязаны читаться и в разговоре.
      -->
      <Button x:Name="ProfilePill"
              Grid.Column="0"
              HorizontalContentAlignment="Stretch"
              Style="{StaticResource PanelProfilePillStyle}"
              Padding="6,0"
              IsEnabled="{Binding CanOpenProfileMenu}"
              Click="OnProfileClick"
              AutomationProperties.Name="{Binding StatusTitle, StringFormat=Профиль {0}}">
        <Button.ContextMenu>
          <ContextMenu Style="{StaticResource PanelProfileMenuStyle}">
            <ContextMenu.Resources>
              <Style TargetType="MenuItem" BasedOn="{StaticResource PanelProfileMenuItemStyle}" />
            </ContextMenu.Resources>
            <!--
                Профиль пока один — их список приедет с «Управлением», и
                тогда здесь встанет `ItemsSource`. Одна строка в меню не
                лишняя и сейчас: она отвечает на вопрос «под кем я», а
                галочка рядом с ней — на вопрос «на линии ли».
            -->
            <MenuItem Tag="single-profile"
                      IsChecked="{Binding IsOnline, Mode=OneWay}"
                      Command="{Binding GoOnline}">
              <MenuItem.Header>
                <TextBlock theme:Emoji.Text="{Binding ProfileMenuTitle}" MaxWidth="260" TextWrapping="Wrap" />
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="{res:Loc PanelOffline}"
                      IsChecked="{Binding IsOfflineByChoice, Mode=OneWay}"
                      Command="{Binding GoOffline}" />
            <MenuItem Header="{res:Loc TrayQuit}" Command="{Binding Quit}" />
          </ContextMenu>
        </Button.ContextMenu>

        <!-- Сетка, а не StackPanel: в горизонтальной стопке обрезка не срабатывает,
             и длинное имя профиля выталкивало шестерёнку за край панели.
             Сжимается первой подпись, номер — только когда места нет совсем. -->
        <Grid><TextBlock x:Name="OfflineProfileLabel" Text="{res:Loc PanelOffline}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding IsOfflineByChoice, Converter={StaticResource BoolToVisibility}}" />
        <Grid x:Name="OnlineProfileIdentity" VerticalAlignment="Center" Visibility="{Binding IsOfflineByChoice, Converter={StaticResource NotBoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!--
              Точка состояния. Единственное, чем показано обычное положение
              дел: подпись «На линии» рядом с зелёным кружком занимала место и
              не сообщала ничего сверх него.

              Отключение решением оператора важнее любого состояния
              регистрации и потому стоит последним: правила WPF выбирают
              последнее сработавшее.
          -->
          <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Registration}" Value="Registering">
                    <Setter Property="Fill" Value="{DynamicResource StatusConnectingBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Registration}" Value="Registered">
                    <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Registration}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource StatusFailureBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsOfflineByChoice}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusTitle}"
                     TextTrimming="CharacterEllipsis"
                     Margin="3,0,0,0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <!--
              Пометка профиля вторым планом и ужимается первой: без неё
              «172 · Офис» и «172 · Удалённо» в свёрнутом виде неразличимы, а
              различаются они адресом сервера — тем, дозвонится оператор или
              нет.
          -->
          <TextBlock Grid.Column="2"
                     theme:Emoji.Text="{Binding StatusLabel}"
                     Margin="3,0,0,0"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="{Binding StatusLabel, Converter={StaticResource PresenceToVisibility}}" />

          <!--
              Шеврон — единственное, чем капсула сообщает, что она кнопка со
              списком, а не подпись.
          -->
          <theme:Icon Grid.Column="3"
                      Glyph="chevron.down"
                      Size="10"
                      Margin="3,1,0,0"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      Visibility="{Binding CanOpenProfileMenu, Converter={StaticResource BoolToVisibility}}" />
        </Grid></Grid>
      </Button>

      <!--
          Слот беды. Пустует почти весь день, и это правильно: место здесь
          занято не текстом, а его возможностью — появление надписи не должно
          ничего двигать. Обычное состояние сюда не пишется вовсе, его несёт
          цвет точки слева.
      -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Margin="6,0,6,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding Trouble, Converter={StaticResource PresenceToVisibility}}">
        <theme:Icon Glyph="{Binding Trouble.Glyph}"
                    Size="10"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource CautionBrush}"
                    Visibility="{Binding Trouble.Glyph, Converter={StaticResource PresenceToVisibility}}" />
        <TextBlock Text="{Binding Trouble.Text}"
                   Margin="4,0,0,0"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource CautionBrush}" />
      </StackPanel>

      <!--
          Короткий статус в том же месте: «Подключаюсь…», «Перезапускаю
          звук…», «Нет звука собеседника». Пуст в стабильной работе и в полном
          отключении. Беда его перекрывает, спокойное сообщение уступает ему.
      -->
      <Grid Grid.Column="1"
            Margin="6,0,6,0"
            VerticalAlignment="Center"
            Visibility="{Binding ShowsActivity, Converter={StaticResource BoolToVisibility}}">
        <!-- Сеткой, а не строкой: в строке текст получает бесконечную ширину
             и обрезается краем без многоточия. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <theme:Icon Glyph="{Binding Activity.Glyph}"
                    Size="10"
                    VerticalAlignment="Center">
          <theme:Icon.Style>
            <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </theme:Icon.Style>
        </theme:Icon>
        <TextBlock Grid.Column="1"
                   Text="{Binding Activity.Text}"
                   Margin="4,0,0,0"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- Спокойное сообщение в том же месте: «Администратор сменил номер: 205».
           Уходит по щелчку; беда его перекрывает. -->
      <Button Grid.Column="1"
              Margin="6,0,6,0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Style="{StaticResource PanelIconButtonStyle}"
              Command="{Binding DismissNotice}"
              Visibility="{Binding ShowsNotice, Converter={StaticResource BoolToVisibility}}">
        <TextBlock theme:Emoji.Text="{Binding Notice}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Button>

      <Button Grid.Column="2"
              Style="{StaticResource PanelIconButtonStyle}"
              Command="{Binding ShowSettings}"
              ToolTip="{res:Loc PanelSettings}">
        <theme:Icon Glyph="slider.horizontal.2" Size="16" />
      </Button>
    </Grid>

    <!-- ==================== Изменчивая середина ==================== -->

    <Grid Grid.Row="2" x:Name="Middle">
      <!--
          Середина — сетка, а не стопка: стопка отдаёт детям ровно их
          высоту, и растянутое окно оставляло бы под макросами пустоту.
          Высоты строк громкости, клавиш и макросов выставляет код окна
          (UpdateRows): растягивание — макросам, без них поровну фреймам
          громкости; поле номера, клавиши-значки и низ постоянной высоты.
      -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>


      <!--
          Шапка: поле набора в покое, собеседник с таймером в разговоре, два
          поля при двух линиях. Высота у всех трёх одна и та же — иначе при
          ответе на вызов шапка вырастала бы и сдвигала вниз всё, что под ней.
      -->
      <Grid x:Name="NumberInputArea" Grid.Row="0" Height="72">

        <!-- Одна линия или покой: одна поверхность на весь слот. -->
        <Border CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="14,0"
                BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="0,1,0,0"
                Effect="{StaticResource PanelShadow}"
                Background="{DynamicResource PanelCallBrush}"
                Visibility="{Binding HasSecondLine, Converter={StaticResource NotBoolToVisibility}}">
          <Grid>

            <!--
                Поле набора. Настоящее текстовое поле, а не подпись: дайлпада
                больше нет, номер вводится с клавиатуры — значит поле обязано
                быть полем. Отсюда бесплатно берутся забой, выделение и вставка,
                которых в панели не было.
            -->
            <Grid Visibility="{Binding IsInCall, Converter={StaticResource NotBoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--
                  Enter звонит. Это то, что на Windows пробуют первым: набрали
                  номер — нажали Enter. Отдельной кнопкой «позвонить» это не
                  заменяется, потому что до неё надо дотянуться мышью.
              -->
              <TextBox x:Name="DialedNumberField" Grid.Column="0"
                       Style="{StaticResource PanelTextBoxStyle}"
                       Text="{Binding DialedNumber, UpdateSourceTrigger=PropertyChanged}"
                       Tag="{res:Loc PanelNumberPlaceholder}"
                       FontSize="20"
                       KeyDown="OnDialedNumberKeyDown"
                       PreviewTextInput="OnDialedNumberTextInput" />

              <Button Grid.Column="1"
                      Style="{StaticResource PanelIconButtonStyle}"
                      ToolTip="{res:Loc PanelClearNumber}"
                      Click="OnClearNumberClick"
                      Visibility="{Binding HasDialedNumber, Converter={StaticResource BoolToVisibility}}">
                <theme:Icon Glyph="xmark.circle.fill" Size="12" />
              </Button>
            </Grid>

            <!--
                Карточка собеседника: имя, под ним номер, справа внизу время.
            -->
            <Grid x:Name="CallHeader" VerticalAlignment="Center"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVisibility}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="CallTitleLabel" Grid.Row="0"
                         theme:Emoji.Text="{Binding CallTitle}"
                         FontSize="17" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <!--
                  Под именем одной строкой номер и состояние; нет номера —
                  состояние у левого края. Состояние всегда золотистым, как
                  «Гудки…»: читается с одного взгляда. Время — справа внизу,
                  ниже и шире (разрядка), как на macOS. Высота строки задана под
                  время с самого начала: иначе в момент ответа имя подскакивало.
              -->
              <Grid Grid.Row="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CallNumberPart" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ActiveLine.SecondaryNumber, Converter={StaticResource PresenceToVisibility}}">
                  <TextBlock Text="{Binding ActiveLine.SecondaryNumber}" FontSize="12"
                             TextTrimming="CharacterEllipsis" MaxWidth="130" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="·" FontSize="12" Margin="5,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="CallStatusLabel" Grid.Column="1" Text="{Binding CallStatus}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusConnectingBrush}" />
                <ItemsControl x:Name="CallDuration" Grid.Column="3" ItemsSource="{Binding ActiveLine.Duration}" VerticalAlignment="Bottom"
                              Focusable="False" IsTabStop="False"
                              Visibility="{Binding IsOutgoingPending, Converter={StaticResource NotBoolToVisibility}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="19" FontWeight="Bold" Margin="0,0,1.5,0"
                                 Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <!--
            Две линии — два поля в том же слоте. Отдельной полосы линий нет:
            линия и есть собеседник, и показывать их порознь значит дважды
            писать одно и то же.
        -->
        <ItemsControl ItemsSource="{Binding Lines}"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasSecondLine, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type panel:CallLineViewModel}">
              <Border Height="22"
                      Margin="0,0,0,4"
                      CornerRadius="{StaticResource PanelCornerRadius}"
                      Padding="8,0"
                      Background="{DynamicResource PanelCallBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!--
                      Точка стоит в колонке шириной с точку капсулы, а не по
                      своему размеру: она мельче (6 против 8), и выровненные по
                      краю кружки разошлись бы центрами. Колонка выравнивает
                      именно центры — глаз считывает их, а не края.
                  -->
                  <Ellipse Grid.Column="0"
                           Width="6"
                           Height="6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource TextTertiaryBrush}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>

                  <TextBlock Grid.Column="1"
                             theme:Emoji.Text="{Binding Title}"
                             Margin="6,0,4,0"
                             FontSize="13"
                             FontWeight="Medium"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding Status}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- Шапка → громкость и клавиши. -->
      <Border Grid.Row="1" Height="8" />

      <!--
          Громкость и клавиши. КЦ подстраивает громкость собеседника и свою
          постоянно, а «Удержать», «Перевести» и «Конференция» нужны редко:
          два широких фрейма громкости высотой с поле номера, под ними три
          маленькие клавиши-значка. Громкость — те же значения, что в
          настройках: ползунки двигаются вместе, разговор подхватывает их на
          лету. Без ползунков (оформление) в ряду появляется микрофон.

          Ряд клавиш виден и в покое, только выключенным: прятать его значит
          менять геометрию панели ровно в момент ответа на вызов.
      -->
      <Grid Grid.Row="2" x:Name="ControlKeys">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="72" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" MinHeight="72" />
          <RowDefinition Height="8" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style x:Key="VolumeFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
            <Setter Property="Padding" Value="10,8,12,8" />
            <Setter Property="Background" Value="{DynamicResource PanelCallBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
          </Style>
          <Style x:Key="VolumeHeadStyle" TargetType="ToggleButton" BasedOn="{StaticResource PanelControlKeyStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Tag" Value="Warning" />
          </Style>
          <Style x:Key="IconKeyStyle" TargetType="ToggleButton" BasedOn="{StaticResource PanelControlKeyStyle}">
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </Grid.Resources>

        <Border Grid.Row="0" x:Name="PeerVolumeFrame" Style="{StaticResource VolumeFrameStyle}"
                Visibility="{Binding ShowsVolume, Converter={StaticResource BoolToVisibility}}">
          <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Нажатие уводит звук собеседника в ноль и краснеет; повторное
                   возвращает прежнюю громкость. -->
              <ToggleButton x:Name="PeerMuteKey" Style="{StaticResource VolumeHeadStyle}"
                            IsChecked="{Binding Audio.PlaybackVolume, Mode=OneWay, Converter={StaticResource IsZero}}"
                            Click="OnPeerMuteClick" ToolTip="{res:Loc PanelPeerVolume}" AutomationProperties.Name="{res:Loc PanelPeerVolume}">
                <StackPanel Orientation="Horizontal" Margin="10,0,12,0">
                  <theme:Icon Glyph="settings.headphones" Size="16" VerticalAlignment="Center"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                  <TextBlock Text="{res:Loc PanelPeerVolume}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <TextBlock Grid.Column="1" Text="{Binding Audio.PlaybackVolume, Converter={StaticResource Percent}}"
                         FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <Slider Grid.Row="1" x:Name="PeerVolume" Style="{StaticResource VolumeSliderStyle}"
                    Value="{Binding Audio.PlaybackVolume}" AutomationProperties.Name="{res:Loc PanelPeerVolume}" />
          </Grid>
        </Border>

        <Border Grid.Row="2" x:Name="MicrophoneVolumeFrame" Style="{StaticResource VolumeFrameStyle}"
                Visibility="{Binding ShowsVolume, Converter={StaticResource BoolToVisibility}}">
          <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Нажатие выключает микрофон и краснеет; повторное включает. -->
              <ToggleButton x:Name="MicrophoneVolumeKey" Style="{StaticResource VolumeHeadStyle}"
                            IsChecked="{Binding IsMicrophoneMuted, Mode=OneWay}" IsEnabled="{Binding CanMuteMicrophone}"
                            Click="OnMicrophoneClick" ToolTip="{res:Loc PanelMicrophone}" AutomationProperties.Name="{res:Loc PanelMicrophone}">
                <StackPanel Orientation="Horizontal" Margin="10,0,12,0">
                  <theme:Icon Size="16" VerticalAlignment="Center"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                    <theme:Icon.Style>
                      <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                        <Setter Property="Glyph" Value="settings.mic" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                            <Setter Property="Glyph" Value="mic.slash.fill" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </theme:Icon.Style>
                  </theme:Icon>
                  <TextBlock Text="{res:Loc PanelMyVolume}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <TextBlock Grid.Column="1" Text="{Binding Audio.MicrophoneGain, Converter={StaticResource Percent}}"
                         FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <!-- Недоступен при автоматической регулировке — как в настройках. -->
            <Slider Grid.Row="1" x:Name="MicrophoneVolume" Style="{StaticResource VolumeSliderStyle}"
                    Value="{Binding Audio.MicrophoneGain}" IsEnabled="{Binding Audio.GainIsAdjustable}"
                    AutomationProperties.Name="{res:Loc PanelMyVolume}" />
          </Grid>
        </Border>

        <!--
            Всплывающие окна — как на macOS: под своей клавишей, по центру, со
            стрелкой к ней. Перевод: поле номера и «Отмена» / «Перевести»
            (Enter — перевести, Esc — отмена); раньше поле вставало на место
            макросов и прятало их.
        -->
        <Popup x:Name="TransferPopup" PlacementTarget="{Binding ElementName=TransferKey}" Placement="Custom"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Opened="OnBubbleOpened"
               IsOpen="{Binding IsTransferEntryVisible, Mode=OneWay}" Closed="OnTransferPopupClosed">
          <StackPanel x:Name="TransferBubble" Margin="10,0,10,12">
            <Path x:Name="TransferArrowUp" Data="M0,8 L8,0 L16,8 Z" Width="16" Height="8" HorizontalAlignment="Left" Margin="0,0,0,-1"
                  Fill="{DynamicResource PanelControlBrush}" />
            <Border Width="264" Padding="12" CornerRadius="{StaticResource PanelCornerRadius}" Background="{DynamicResource PanelControlBrush}"
                    BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="0,1,0,0" Effect="{StaticResource PanelShadow}">
              <StackPanel>
                <!-- Подпись «Номер перевода» стоит в пустом поле и при курсоре
                     в нём: поле открывается уже в фокусе. -->
                <Border Height="40" CornerRadius="{StaticResource PanelCornerRadius}" Padding="12,0" Background="{DynamicResource PanelCallBrush}">
                  <Grid>
                    <TextBlock Text="{res:Loc PanelTransferNumber}" FontSize="16" VerticalAlignment="Center" Margin="2,0,0,0"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding HasTransferNumber, Converter={StaticResource NotBoolToVisibility}}" />
                    <TextBox x:Name="TransferField"
                             Style="{StaticResource PanelTextBoxStyle}"
                             Text="{Binding TransferNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" VerticalAlignment="Center"
                             IsEnabled="{Binding IsTransferring, Converter={StaticResource NotBool}}"
                             KeyDown="OnTransferFieldKeyDown" />
                  </Grid>
                </Border>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource PanelSurfaceButtonStyle}" Height="32"
                          Content="{res:Loc PanelCancel}" FontSize="13" HorizontalContentAlignment="Center"
                          IsEnabled="{Binding IsTransferring, Converter={StaticResource NotBool}}" Click="OnCancelTransferClick" />
                  <Button Grid.Column="2" Style="{StaticResource PanelCallButtonStyle}" Height="32"
                          FontSize="13" IsEnabled="{Binding HasTransferNumber}" Command="{Binding Transfer}">
                    <TextBlock Text="{res:Loc PanelTransfer}" Foreground="White" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
            <Path x:Name="TransferArrowDown" Data="M0,0 L8,8 L16,0 Z" Width="16" Height="8" HorizontalAlignment="Left" Margin="0,-1,0,0"
                  Fill="{DynamicResource PanelControlBrush}" Visibility="Collapsed" />
          </StackPanel>
        </Popup>

        <!-- Подтверждение удержания и конференции — от случайного щелчка:
             клавиши маленькие и стоят рядом. Значок в кружке, вопрос, справа
             «Отмена» и действие (Enter — действие, Esc — отмена). -->
        <Popup x:Name="ConfirmPopup" PreviewKeyDown="OnConfirmPopupKeyDown" PlacementTarget="{Binding ElementName=HoldKey}" Placement="Custom"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Opened="OnBubbleOpened">
          <StackPanel x:Name="ConfirmBubble" Margin="10,0,10,12">
            <Path x:Name="ConfirmArrowUp" Data="M0,8 L8,0 L16,8 Z" Width="16" Height="8" HorizontalAlignment="Left" Margin="0,0,0,-1"
                  Fill="{DynamicResource PanelControlBrush}" />
            <Border Padding="14" CornerRadius="{StaticResource PanelCornerRadius}" Background="{DynamicResource PanelControlBrush}"
                    BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="0,1,0,0" Effect="{StaticResource PanelShadow}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelSelectedBrush}">
                    <theme:Icon x:Name="ConfirmIcon" Size="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                  </Border>
                  <TextBlock x:Name="ConfirmText" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                  <Button Style="{StaticResource PanelSurfaceButtonStyle}" Height="28" MinWidth="76" Padding="12,0"
                          Content="{res:Loc PanelCancel}" FontSize="13" HorizontalContentAlignment="Center" Click="OnConfirmCancelClick" />
                  <Button x:Name="ConfirmAction" Style="{StaticResource PanelCallButtonStyle}" Height="28" MinWidth="76" Margin="8,0,0,0"
                          FontSize="13" Click="OnConfirmClick">
                    <TextBlock x:Name="ConfirmActionText" Foreground="White" Margin="12,0" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
            <Path x:Name="ConfirmArrowDown" Data="M0,0 L8,8 L16,0 Z" Width="16" Height="8" HorizontalAlignment="Left" Margin="0,-1,0,0"
                  Fill="{DynamicResource PanelControlBrush}" Visibility="Collapsed" />
          </StackPanel>
        </Popup>

        <!--
            Имена для доступности стоят на всём, что нажимается: теми же именами
            живая проверка находит элементы в окне, не целясь в него мышью.
            Конференция — штатное действие, а не макрос: приложение знает, что
            комната собрана.
        -->
        <Grid Grid.Row="4" x:Name="KeysRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
          </Grid.ColumnDefinitions>
          <ToggleButton Grid.Column="0" x:Name="HoldKey"
                        IsChecked="{Binding IsOnHold, Mode=OneWay}" IsEnabled="{Binding CanHold}" Click="OnHoldClick"
                        AutomationProperties.Name="{res:Loc PanelHold}">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource IconKeyStyle}">
                <Setter Property="ToolTip" Value="{res:Loc PanelHold}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOnHold}" Value="True"><Setter Property="ToolTip" Value="{res:Loc PanelResume}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
            <theme:Icon Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
              <theme:Icon.Style>
                <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                  <Setter Property="Glyph" Value="pause.fill" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnHold}" Value="True"><Setter Property="Glyph" Value="play.fill" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </theme:Icon.Style>
            </theme:Icon>
          </ToggleButton>
          <ToggleButton Grid.Column="2" x:Name="ConferenceKey" Style="{StaticResource IconKeyStyle}"
                        IsChecked="{Binding IsConferenceStarted, Mode=OneWay}" IsEnabled="{Binding CanStartConference}" Click="OnConferenceClick"
                        ToolTip="{res:Loc PanelConference}" AutomationProperties.Name="{res:Loc PanelConference}">
            <theme:Icon Glyph="person.3.fill" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </ToggleButton>
          <ToggleButton Grid.Column="4" x:Name="TransferKey" Style="{StaticResource IconKeyStyle}"
                        AutomationProperties.AutomationId="TransferKey" AutomationProperties.Name="{res:Loc PanelTransfer}"
                        ToolTip="{res:Loc PanelTransfer}"
                        IsChecked="{Binding IsTransferEntryVisible, Mode=OneWay}" IsEnabled="{Binding CanTransfer}" Click="OnTransferClick">
            <theme:Icon Glyph="phone.arrow.right" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </ToggleButton>
          <!-- Без ползунков громкости микрофон отключается здесь. -->
          <ToggleButton Grid.Column="6" x:Name="MicrophoneKey" Style="{StaticResource IconKeyStyle}" Tag="Warning"
                        Visibility="{Binding ShowsVolume, Converter={StaticResource NotBoolToVisibility}}"
                        IsChecked="{Binding IsMicrophoneMuted, Mode=OneWay}" IsEnabled="{Binding CanMuteMicrophone}" Click="OnMicrophoneClick"
                        ToolTip="{res:Loc PanelMicrophone}" AutomationProperties.Name="{res:Loc PanelMicrophone}">
            <theme:Icon Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
              <theme:Icon.Style>
                <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                  <Setter Property="Glyph" Value="mic.fill" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True"><Setter Property="Glyph" Value="mic.slash.fill" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </theme:Icon.Style>
            </theme:Icon>
          </ToggleButton>
        </Grid>
      </Grid>

      <!-- Зазор под макросами; без них его нет. -->
      <Border Grid.Row="3" x:Name="MacroGap" Height="8" />

      <!--
          Сетка макросов на месте бывшего дайлпада. Крупная подпись, три в ряд,
          порядок постоянный: оператор целится в место, а не читает каждый раз.
          Вне разговора клавиши видны, но выключены — раскладка должна
          запоминаться глазами до того, как начнётся звонок.
      -->
      <ItemsControl Grid.Row="4" x:Name="Macros" ItemsSource="{Binding Macros}">

        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--
                Промежуток между клавишами задан полем справа и снизу у каждой,
                а лишнее поле по краю снято отрицательным полем самой сетки. Так
                ряды и колонки получают одинаковые 8 точек, а сетка не отступает
                от краёв панели.
            -->
            <UniformGrid Columns="{Binding MacroColumns}" Margin="0,0,-8,-8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type panel:MacroViewModel}">
            <Button Style="{StaticResource PanelMacroKeyStyle}"
                    Margin="0,0,8,8"
                    MinHeight="{Binding DataContext.EffectiveMacroHeight,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    IsEnabled="{Binding DataContext.CanSendDtmf, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Command="{Binding DataContext.SendMacro, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
              <!--
                  Подпись из одного слова переносить некуда: `Wrap` разрывал бы
                  «Бухгалтерию» посреди слова, оставляя висячий слог, — это
                  первое, что показал живой прогон. `WrapWithOverflow` переносит
                  только по пробелам, поэтому из нескольких слов подпись
                  переносится, а из одного остаётся строкой и вылезает за
                  клавишу.

                  Вылезшее ужимается кеглем — тем же, чем в оригинале работал
                  `minimumScaleFactor`, и до того же предела в 0.6. Обрезать
                  хвост здесь нельзя: «Бухгалтер» вместо «Бухгалтерии» читается
                  как другое слово, а не как обрезанное.
              -->
              <theme:ShrinkBox BaseFontSize="18" Margin="0" GrowsWithHeight="False"
                               FallbackHeight="{Binding DataContext.MacroLabelMaxHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock theme:Emoji.Text="{Binding Title}"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="WrapWithOverflow" />
              </theme:ShrinkBox>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>

    <!-- ==================== Неподвижный низ ==================== -->

    <!--
        Две кнопки, обе всегда на своём месте. «История» стоит здесь, а не в
        полосе заголовка, потому что нужна постоянно: перезвонить по
        пропущенному — основной способ исходящего звонка. Её ширина задана
        жёстко, чтобы кнопка звонка не меняла размер от длины подписи.
    -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="76" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              x:Name="PrimaryCallButton" Command="{Binding CallOrHangUp}"
              IsEnabled="{Binding IsCallButtonEnabled}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PanelCallButtonStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsInCall}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelDeclineBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>

        <StackPanel Orientation="Horizontal">
          <theme:Icon Size="14" VerticalAlignment="Center" Foreground="White">
            <theme:Icon.Style>
              <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                <Setter Property="Glyph" Value="phone.fill" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsInCall}" Value="True">
                    <Setter Property="Glyph" Value="phone.down.fill" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </theme:Icon.Style>
          </theme:Icon>

          <TextBlock Margin="6,0,0,0" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="White">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{res:Loc PanelCall}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsInCall}" Value="True">
                    <Setter Property="Text" Value="{res:Loc PanelHangUp}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Style="{StaticResource PanelSurfaceButtonStyle}"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Padding="0,0,0,1"
              x:Name="HistoryActionButton" Command="{Binding ShowHistory}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <theme:Icon Glyph="clock" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Grid.Row="1" Text="{res:Loc PanelHistory}"
                     Margin="0,2,0,0"
                     FontSize="11"
                     HorizontalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>
  </Grid>
  </Border>
</Window>
