<Window x:Class="EliteSIP.App.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:panel="clr-namespace:EliteSIP.App.Panel"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=panel:PanelViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{res:Loc PanelWindowTitle}"
        Width="324"
        MinWidth="270"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{DynamicResource PanelWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

  <!--
      Содержимое определяет минимальную высоту окна. При первом показе код
      задаёт вытянутую форму 4:3, как в Linux-клиенте; размер оператора
      восстанавливается при следующих запусках.

      Плата за это — в code-behind: растущее окно Windows тянет вниз, оставляя
      на месте верхний край, а неподвижным в панели обязан быть нижний.
  -->

  <!-- Windows 11 использует штатный заголовок с цветом DWM; Windows 10 — общий фон и свой заголовок. -->

  <!--
      Поля 12 со всех сторон и шаг сетки, кратный четырём: это тот же ритм, по
      которому набраны системные окна Windows 11. Прежние 5 и 15 между рядами
      были пересчётом macOS-овских отступов и в общий шаг не ложились.
  -->
  <!--
      Панель тянется за край (11 сентября 2026).

      С 0.1.60 растягивание увеличивает только горячие клавиши: окно тянут
      ради них (29 сентября 2026, владелец). Масштаба всего окна больше нет —
      он растил и поле номера, и «Позвонить», а клавишам доставалась та же
      доля. Лишняя высота уходит сетке клавиш; без клавиш — кнопкам
      управления, чтобы не оставалось пустоты. Выше экрана окно не бывает:
      не влезает — клавиши ниже (см. `FitMacroHeight`).
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Graphite.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Height="32" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
              <Image Source="/EliteSIP.App;component/Assets/AppIcon/EliteSIP.ico" Width="14" Height="14" />
              <TextBlock Text="{TemplateBinding Title}" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="{res:Loc WindowMinimize}" AutomationProperties.Name="{res:Loc WindowMinimize}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10" /></Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMaximizeClick" ToolTip="{res:Loc WindowMaximize}" AutomationProperties.Name="{res:Loc WindowMaximize}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Tag="Close" Click="OnCaptionCloseClick" ToolTip="{res:Loc WindowClose}" AutomationProperties.Name="{res:Loc WindowClose}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10" /></Button>
            </StackPanel>
          </Grid>
          <AdornerDecorator><ContentPresenter /></AdornerDecorator>
        </DockPanel>
      </Border>
    </ControlTemplate>
  </Window.Template>


  <Border x:Name="Frame">
  <Grid x:Name="Root" Margin="8">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <!-- Строка состояния. -->
      <RowDefinition Height="22" />
      <RowDefinition Height="8" />
      <!--
          Изменчивая середина. Всё, что может поменять высоту — вторая линия,
          поле перевода, число макросов, — живёт здесь.
      -->
      <RowDefinition Height="5*" />
      <RowDefinition Height="10" />
      <!-- Неподвижный низ: звонок и история. С 0.1.60 от окна не растёт —
           лишняя высота вся уходит клавишам. -->
      <RowDefinition Height="Auto" MinHeight="52" />
    </Grid.RowDefinitions>

    <!--
        Строка состояния: капсула профиля слева, слот беды посередине,
        шестерёнка справа. Крайние слоты не меняют размер никогда, средний
        тянется и обрезается — иначе капсула ездила бы от длины чужой надписи.
    -->
    <Grid Grid.Row="0" SizeChanged="OnStatusRowSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="72" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--
          Капсула профиля: точка состояния, номер, пометка, шеврон.
          Состояние и профиль в одном месте намеренно — это один вопрос,
          «кто я и на линии ли я», а не два.

          И это кнопка со списком, а не подпись. В оригинале так и было, а
          порт до этого оставил от неё одну плашку — из-за чего уйти с линии
          можно было только из меню значка в области уведомлений, то есть
          свернув панель, которая для этого и открыта.

          В разговоре не нажимается: смена профиля и отключение снимают
          регистрацию и оборвали бы разговор. Гаснет при этом один шеврон —
          номер и точка обязаны читаться и в разговоре.
      -->
      <Button x:Name="ProfilePill"
              Grid.Column="0"
              HorizontalContentAlignment="Stretch"
              Style="{StaticResource PanelProfilePillStyle}"
              Padding="6,0"
              IsEnabled="{Binding CanOpenProfileMenu}"
              Click="OnProfileClick"
              AutomationProperties.Name="{Binding StatusTitle, StringFormat=Профиль {0}}">
        <Button.ContextMenu>
          <ContextMenu>
            <!--
                Профиль пока один — их список приедет с «Управлением», и
                тогда здесь встанет `ItemsSource`. Одна строка в меню не
                лишняя и сейчас: она отвечает на вопрос «под кем я», а
                галочка рядом с ней — на вопрос «на линии ли».
            -->
            <MenuItem Tag="single-profile"
                      Header="{Binding ProfileMenuTitle}"
                      IsChecked="{Binding IsOnline, Mode=OneWay}"
                      Command="{Binding GoOnline}" />
            <Separator />
            <MenuItem Header="{res:Loc PanelOffline}"
                      IsChecked="{Binding IsOfflineByChoice, Mode=OneWay}"
                      Command="{Binding GoOffline}" />
          </ContextMenu>
        </Button.ContextMenu>

        <!-- Сетка, а не StackPanel: в горизонтальной стопке обрезка не срабатывает,
             и длинное имя профиля выталкивало шестерёнку за край панели.
             Сжимается первой подпись, номер — только когда места нет совсем. -->
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!--
              Точка состояния. Единственное, чем показано обычное положение
              дел: подпись «На линии» рядом с зелёным кружком занимала место и
              не сообщала ничего сверх него.

              Отключение решением оператора важнее любого состояния
              регистрации и потому стоит последним: правила WPF выбирают
              последнее сработавшее.
          -->
          <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Registration}" Value="Registering">
                    <Setter Property="Fill" Value="{DynamicResource StatusConnectingBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Registration}" Value="Registered">
                    <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Registration}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource StatusFailureBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsOfflineByChoice}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusOfflineBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusTitle}"
                     TextTrimming="CharacterEllipsis"
                     Margin="3,0,0,0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <!--
              Пометка профиля вторым планом и ужимается первой: без неё
              «172 · Офис» и «172 · Удалённо» в свёрнутом виде неразличимы, а
              различаются они адресом сервера — тем, дозвонится оператор или
              нет.
          -->
          <TextBlock Grid.Column="2"
                     theme:Emoji.Text="{Binding StatusLabel}"
                     Margin="3,0,0,0"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     Visibility="{Binding StatusLabel, Converter={StaticResource PresenceToVisibility}}" />

          <!--
              Шеврон — единственное, чем капсула сообщает, что она кнопка со
              списком, а не подпись.
          -->
          <theme:Icon Grid.Column="3"
                      Glyph="chevron.down"
                      Size="10"
                      Margin="3,1,0,0"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      Visibility="{Binding CanOpenProfileMenu, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Button>

      <!--
          Слот беды. Пустует почти весь день, и это правильно: место здесь
          занято не текстом, а его возможностью — появление надписи не должно
          ничего двигать. Обычное состояние сюда не пишется вовсе, его несёт
          цвет точки слева.
      -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Margin="6,0,6,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding Trouble, Converter={StaticResource PresenceToVisibility}}">
        <theme:Icon Glyph="{Binding Trouble.Glyph}"
                    Size="10"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource CautionBrush}"
                    Visibility="{Binding Trouble.Glyph, Converter={StaticResource PresenceToVisibility}}" />
        <TextBlock Text="{Binding Trouble.Text}"
                   Margin="4,0,0,0"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource CautionBrush}" />
      </StackPanel>

      <!--
          Короткий статус в том же месте: «Подключаюсь…», «Перезапускаю
          звук…», «Нет звука собеседника». Пуст в стабильной работе и в полном
          отключении. Беда его перекрывает, спокойное сообщение уступает ему.
      -->
      <Grid Grid.Column="1"
            Margin="6,0,6,0"
            VerticalAlignment="Center"
            Visibility="{Binding ShowsActivity, Converter={StaticResource BoolToVisibility}}">
        <!-- Сеткой, а не строкой: в строке текст получает бесконечную ширину
             и обрезается краем без многоточия. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <theme:Icon Glyph="{Binding Activity.Glyph}"
                    Size="10"
                    VerticalAlignment="Center">
          <theme:Icon.Style>
            <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </theme:Icon.Style>
        </theme:Icon>
        <TextBlock Grid.Column="1"
                   Text="{Binding Activity.Text}"
                   Margin="4,0,0,0"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.IsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- Спокойное сообщение в том же месте: «Администратор сменил номер: 205».
           Уходит по щелчку; беда его перекрывает. -->
      <Button Grid.Column="1"
              Margin="6,0,6,0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Style="{StaticResource PanelIconButtonStyle}"
              Command="{Binding DismissNotice}"
              Visibility="{Binding ShowsNotice, Converter={StaticResource BoolToVisibility}}">
        <TextBlock theme:Emoji.Text="{Binding Notice}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Button>

      <Button Grid.Column="2"
              Style="{StaticResource PanelIconButtonStyle}"
              Command="{Binding ShowSettings}"
              ToolTip="{res:Loc PanelSettings}">
        <theme:Icon Glyph="slider.horizontal.2" Size="16" />
      </Button>
    </Grid>

    <!-- ==================== Изменчивая середина ==================== -->

    <Grid Grid.Row="2">
      <!--
          Середина — сетка, а не стопка: стопка отдаёт детям ровно их
          высоту, и растянутое окно оставляло бы под макросами пустоту.
          Растут два ряда — кнопки управления и макросы; остальные по
          содержимому.
      -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <!--
            Кто получает высоту растянутого окна (30 сентября 2026, владелец).

            Клавиш нет — всю получают кнопки управления.

            Клавиши есть — кнопки управления получают небольшой запас высоты
            (96 → 112), остальное уходит клавишам. Звёздочки с пределами, а не
            расчёт в коде: у кнопок вес в сто раз больше, и они первыми
            добирают до своего потолка; у сетки клавиш нижний предел — её
            собственная высота, так что срезаться ей некуда.
        -->
        <RowDefinition MinHeight="96">
          <RowDefinition.Style>
            <Style TargetType="RowDefinition">
              <Setter Property="Height" Value="*" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasMacros}" Value="True" />
                    <Condition Binding="{Binding ShowsMacros}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Height" Value="100*" />
                  <Setter Property="MaxHeight" Value="112" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </RowDefinition.Style>
        </RowDefinition>
        <RowDefinition Height="Auto" />
        <RowDefinition>
          <!-- Макросы растут, только когда видны: пустой ряд со звёздочкой
               забирал бы свою долю высоты и под полем перевода. -->
          <RowDefinition.Style>
            <Style TargetType="RowDefinition">
              <Setter Property="Height" Value="Auto" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasMacros}" Value="True" />
                    <Condition Binding="{Binding ShowsMacros}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Height" Value="*" />
                  <Setter Property="MinHeight" Value="{Binding MacroGridMinHeight}" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </RowDefinition.Style>
        </RowDefinition>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>


      <!--
          Шапка: поле набора в покое, собеседник с таймером в разговоре, два
          поля при двух линиях. Высота у всех трёх одна и та же — иначе при
          ответе на вызов шапка вырастала бы и сдвигала вниз всё, что под ней.
      -->
      <Grid Grid.Row="0" Height="72">

        <!-- Одна линия или покой: одна поверхность на весь слот. -->
        <Border CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="14,0"
                BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="0,1,0,0"
                Effect="{StaticResource PanelShadow}"
                Background="{DynamicResource PanelCallBrush}"
                Visibility="{Binding HasSecondLine, Converter={StaticResource NotBoolToVisibility}}">
          <Grid>

            <!--
                Поле набора. Настоящее текстовое поле, а не подпись: дайлпада
                больше нет, номер вводится с клавиатуры — значит поле обязано
                быть полем. Отсюда бесплатно берутся забой, выделение и вставка,
                которых в панели не было.
            -->
            <Grid Visibility="{Binding IsInCall, Converter={StaticResource NotBoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--
                  Enter звонит. Это то, что на Windows пробуют первым: набрали
                  номер — нажали Enter. Отдельной кнопкой «позвонить» это не
                  заменяется, потому что до неё надо дотянуться мышью.
              -->
              <TextBox Grid.Column="0"
                       Style="{StaticResource PanelTextBoxStyle}"
                       Text="{Binding DialedNumber, UpdateSourceTrigger=PropertyChanged}"
                       Tag="{res:Loc PanelNumberPlaceholder}"
                       FontSize="20"
                       IsEnabled="{Binding CanPlaceCall}"
                       KeyDown="OnDialedNumberKeyDown"
                       PreviewTextInput="OnDialedNumberTextInput" />

              <Button Grid.Column="1"
                      Style="{StaticResource PanelIconButtonStyle}"
                      ToolTip="{res:Loc PanelClearNumber}"
                      Click="OnClearNumberClick"
                      Visibility="{Binding HasDialedNumber, Converter={StaticResource BoolToVisibility}}">
                <theme:Icon Glyph="xmark.circle.fill" Size="12" />
              </Button>
            </Grid>

            <!--
                Карточка собеседника. Слева имя и номер, справа таймер и состояние.
            -->
            <Grid VerticalAlignment="Center"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MaxWidth="110" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0"
                         theme:Emoji.Text="{Binding CallTitle}"
                         Margin="0,0,12,0"
                         FontSize="18" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOutgoingPending}" Value="True">
                        <Setter Property="Grid.RowSpan" Value="2" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{Binding ActiveLine.SecondaryNumber}"
                         Margin="0,2,12,0" FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding ActiveLine.SecondaryNumber, Converter={StaticResource PresenceToVisibility}}" />
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Text="{Binding ActiveLine.Duration}"
                         HorizontalAlignment="Right"
                         FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOutgoingPending}" Value="True">
                        <Setter Property="Grid.RowSpan" Value="2" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="1"
                         Text="{Binding CallStatus}"
                         HorizontalAlignment="Right"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOutgoingPending}" Value="True">
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.RowSpan" Value="2" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="18" />
                        <Setter Property="Margin" Value="0" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>

        <!--
            Две линии — два поля в том же слоте. Отдельной полосы линий нет:
            линия и есть собеседник, и показывать их порознь значит дважды
            писать одно и то же.
        -->
        <ItemsControl ItemsSource="{Binding Lines}"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasSecondLine, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type panel:CallLineViewModel}">
              <Border Height="22"
                      Margin="0,0,0,4"
                      CornerRadius="{StaticResource PanelCornerRadius}"
                      Padding="8,0"
                      Background="{DynamicResource PanelCallBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!--
                      Точка стоит в колонке шириной с точку капсулы, а не по
                      своему размеру: она мельче (6 против 8), и выровненные по
                      краю кружки разошлись бы центрами. Колонка выравнивает
                      именно центры — глаз считывает их, а не края.
                  -->
                  <Ellipse Grid.Column="0"
                           Width="6"
                           Height="6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource TextTertiaryBrush}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource StatusRegisteredBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>

                  <TextBlock Grid.Column="1"
                             theme:Emoji.Text="{Binding Title}"
                             Margin="6,0,4,0"
                             FontSize="13"
                             FontWeight="Medium"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding Status}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- Шапка → ряд управления. -->
      <Border Grid.Row="1" Height="10" />

      <!--
          Ряд управления. Четыре кнопки в два ряда, а не четыре в один: панель
          270 точек шириной, и «Конференция» в четверти этой ширины не читается.

          Виден и в покое, только выключенным. Прятать его целиком значит
          менять геометрию панели ровно в момент ответа на вызов: макросы и всё
          под ними подскакивали бы на его высоту.
      -->
      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="44" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" MinHeight="44" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Row="0" Grid.Column="0"
                      Style="{StaticResource PanelControlKeyStyle}"
                      IsChecked="{Binding IsOnHold, Mode=OneWay}"
                      IsEnabled="{Binding CanHold}"
                      Command="{Binding ToggleHold}">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Size="10" VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
              <theme:Icon.Style>
                <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                  <Setter Property="Glyph" Value="pause.fill" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnHold}" Value="True">
                      <Setter Property="Glyph" Value="play.fill" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </theme:Icon.Style>
            </theme:Icon>
            <TextBlock Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{res:Loc PanelHold}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnHold}" Value="True">
                      <Setter Property="Text" Value="{res:Loc PanelResume}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ToggleButton>

        <ToggleButton Grid.Row="0" Grid.Column="2"
                      Style="{StaticResource PanelControlKeyStyle}"
                      Tag="Warning"
                      IsChecked="{Binding IsMicrophoneMuted, Mode=OneWay}"
                      IsEnabled="{Binding CanMuteMicrophone}"
                      Command="{Binding ToggleMicrophone}">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Size="10" VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
              <theme:Icon.Style>
                <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                  <Setter Property="Glyph" Value="mic.fill" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                      <Setter Property="Glyph" Value="mic.slash.fill" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </theme:Icon.Style>
            </theme:Icon>
            <!--
                Подпись меняется вместе с состоянием, как у «Удержать»: всегда
                «Микрофон» при подсветке выключенного читалось ровно наоборот.
            -->
            <TextBlock Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{res:Loc PanelMicrophone}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                      <Setter Property="Text" Value="{res:Loc PanelMicrophoneOff}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ToggleButton>

        <!--
            Имена для доступности стоят на всём, что нажимается: в оригинале
            это был `compatAccessibilityLabel`, и заведён он был не ради
            экранного диктора одного — теми же именами живая проверка находит
            элементы в окне, не целясь в него мышью.
        -->
        <ToggleButton Grid.Row="2" Grid.Column="0"
                      Style="{StaticResource PanelControlKeyStyle}"
                      AutomationProperties.AutomationId="TransferKey"
                      AutomationProperties.Name="Перевести"
                      IsChecked="{Binding IsTransferEntryVisible, Mode=OneWay}"
                      IsEnabled="{Binding CanTransfer}"
                      Click="OnTransferClick">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="phone.arrow.right" Size="10" VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <TextBlock Text="{res:Loc PanelTransfer}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <!--
            Конференция — штатное действие, а не макрос: она посылает серверный
            код тонами и помечает линию, то есть приложение знает, что комната
            собрана. Макросом это выглядело бы так же, но приложение не знало бы
            ничего.
        -->
        <ToggleButton Grid.Row="2" Grid.Column="2"
                      Style="{StaticResource PanelControlKeyStyle}"
                      IsChecked="{Binding IsConferenceStarted, Mode=OneWay}"
                      IsEnabled="{Binding CanStartConference}"
                      Command="{Binding StartConference}">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="person.3.fill" Size="10" VerticalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <TextBlock Text="{res:Loc PanelConference}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </Grid>

      <!--
          Ряд управления → то, что под ним. Единственная граница между ними —
          воздух; когда снизу пусто, нет и его.
      -->
      <Border Grid.Row="3" Height="10">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTransferEntryVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasMacros}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasMacros}" Value="False" />
                  <Condition Binding="{Binding IsTransferEntryVisible}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <!--
          Сетка макросов на месте бывшего дайлпада. Крупная подпись, три в ряд,
          порядок постоянный: оператор целится в место, а не читает каждый раз.
          Вне разговора клавиши видны, но выключены — раскладка должна
          запоминаться глазами до того, как начнётся звонок.
      -->
      <ItemsControl Grid.Row="4" ItemsSource="{Binding Macros}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasMacros}" Value="True" />
                  <Condition Binding="{Binding ShowsMacros}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>

        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--
                Промежуток между клавишами задан полем справа и снизу у каждой,
                а лишнее поле по краю снято отрицательным полем самой сетки. Так
                ряды и колонки получают одинаковые 8 точек, а сетка не отступает
                от краёв панели.
            -->
            <UniformGrid Columns="{Binding MacroColumns}" Margin="0,0,-8,-8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type panel:MacroViewModel}">
            <Button Style="{StaticResource PanelMacroKeyStyle}"
                    Margin="0,0,8,8"
                    MinHeight="{Binding DataContext.EffectiveMacroHeight,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    IsEnabled="{Binding DataContext.CanSendDtmf, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Command="{Binding DataContext.SendMacro, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
              <!--
                  Подпись из одного слова переносить некуда: `Wrap` разрывал бы
                  «Бухгалтерию» посреди слова, оставляя висячий слог, — это
                  первое, что показал живой прогон. `WrapWithOverflow` переносит
                  только по пробелам, поэтому из нескольких слов подпись
                  переносится, а из одного остаётся строкой и вылезает за
                  клавишу.

                  Вылезшее ужимается кеглем — тем же, чем в оригинале работал
                  `minimumScaleFactor`, и до того же предела в 0.6. Обрезать
                  хвост здесь нельзя: «Бухгалтер» вместо «Бухгалтерии» читается
                  как другое слово, а не как обрезанное.
              -->
              <theme:ShrinkBox BaseFontSize="18" Margin="0" GrowsWithHeight="False"
                               FallbackHeight="{Binding DataContext.MacroLabelMaxHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock theme:Emoji.Text="{Binding Title}"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="WrapWithOverflow" />
              </theme:ShrinkBox>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--
          Поле перевода занимает место сетки макросов, а не встаёт под ней: пока
          оператор набирает номер перевода, макросы всё равно не нужны, а лишний
          ярус пришлось бы отнять у чего-то другого.
      -->
      <StackPanel Grid.Row="5" Visibility="{Binding IsTransferEntryVisible, Converter={StaticResource BoolToVisibility}}">
        <Border Height="34"
                CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="12,0"
                Background="{DynamicResource PanelCallBrush}">
          <TextBox x:Name="TransferField"
                   Style="{StaticResource PanelTextBoxStyle}"
                   Text="{Binding TransferNumber, UpdateSourceTrigger=PropertyChanged}"
                   Tag="{res:Loc PanelTransferNumber}"
                   FontSize="18"
                   IsEnabled="{Binding IsTransferring, Converter={StaticResource NotBool}}" />
        </Border>

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0"
                  Style="{StaticResource PanelSurfaceButtonStyle}"
                  Height="30"
                  Content="{res:Loc PanelCancel}"
                  FontSize="14"
                  Click="OnCancelTransferClick" />

          <Button Grid.Column="2"
                  Style="{StaticResource PanelCallButtonStyle}"
                  Height="30"
                  Content="{res:Loc PanelTransfer}"
                  FontSize="14"
                  IsEnabled="{Binding HasTransferNumber}"
                  Command="{Binding Transfer}" />
        </Grid>
      </StackPanel>
    </Grid>

    <!-- ==================== Неподвижный низ ==================== -->

    <!--
        Две кнопки, обе всегда на своём месте. «История» стоит здесь, а не в
        полосе заголовка, потому что нужна постоянно: перезвонить по
        пропущенному — основной способ исходящего звонка. Её ширина задана
        жёстко, чтобы кнопка звонка не меняла размер от длины подписи.
    -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="76" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Command="{Binding CallOrHangUp}"
              IsEnabled="{Binding IsCallButtonEnabled}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PanelCallButtonStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsInCall}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelDeclineBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>

        <StackPanel Orientation="Horizontal">
          <theme:Icon Size="14" VerticalAlignment="Center" Foreground="White">
            <theme:Icon.Style>
              <Style TargetType="theme:Icon" BasedOn="{StaticResource {x:Type theme:Icon}}">
                <Setter Property="Glyph" Value="phone.fill" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsInCall}" Value="True">
                    <Setter Property="Glyph" Value="phone.down.fill" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </theme:Icon.Style>
          </theme:Icon>

          <TextBlock Margin="6,0,0,0" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="White">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{res:Loc PanelCall}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsInCall}" Value="True">
                    <Setter Property="Text" Value="{res:Loc PanelHangUp}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Style="{StaticResource PanelSurfaceButtonStyle}"
              Command="{Binding ShowHistory}">
        <StackPanel>
          <theme:Icon Glyph="clock" Size="14" HorizontalAlignment="Center"
                      Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{res:Loc PanelHistory}"
                     Margin="0,2,0,0"
                     FontSize="11"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
  </Border>
</Window>
