<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EliteSIP.SipCore\EliteSIP.SipCore.csproj" />
    <ProjectReference Include="..\EliteSIP.SipCore.Udp\EliteSIP.SipCore.Udp.csproj" />
    <ProjectReference Include="..\EliteSIP.MediaCore\EliteSIP.MediaCore.csproj" />
    <ProjectReference Include="..\EliteSIP.Audio\EliteSIP.Audio.csproj" />
    <ProjectReference Include="..\EliteSIP.CallGuard\EliteSIP.CallGuard.csproj" />

    <!-- Слой линий: до трёх разговоров и один тракт на них. Готов с W6. -->
    <ProjectReference Include="..\EliteSIP.Lines\EliteSIP.Lines.csproj" />
    <ProjectReference Include="..\EliteSIP.CallHistory\EliteSIP.CallHistory.csproj" />
    <ProjectReference Include="..\EliteSIP.AdminAccess\EliteSIP.AdminAccess.csproj" />
    <ProjectReference Include="..\EliteSIP.PanelLink\EliteSIP.PanelLink.csproj" />
    <ProjectReference Include="..\EliteSIP.Diagnostics\EliteSIP.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
        Значок приложения — тот же, что у macOS-версии: он лежит в
        `Assets.xcassets/AppIcon.appiconset` оригинала и переиспользуется как
        есть. Рисовать второй значок значило бы завести вторую правду о том,
        как приложение выглядит; собран он в один `.ico` со всеми размерами,
        потому что Windows берёт из файла тот, который ей нужен, — от 16 в
        заголовке окна до 256 в проводнике.

        PNG комплекта лежат рядом не ради сборки, а ради человека: из них
        значок собран, и из них же его пересоберут, когда рисунок сменится.
    -->
    <None Include="Assets\AppIcon\*.png" />

    <!--
        Заставка при запуске (0.1.65). Показывает её сама Windows, ещё до
        загрузки WPF, — через доли секунды после щелчка по ярлыку, а не через
        две с половиной, когда поднимется панель. Закрывается сама, как только
        приложение начнёт отвечать. Время до готовой панели она не меняет —
        меняет то, что оператор видит, что программа запускается.
    -->
    <SplashScreen Include="Assets\Splash.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\AppIcon\EliteSIP.ico</ApplicationIcon>

    <!--
      Свой манифест ради помониторной осведомлённости о DPI: без него
      приложение остаётся системно-осведомлённым и мылится на втором мониторе
      с другим масштабом. Разбор — в самом файле.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

  </PropertyGroup>

</Project>
