<Window x:Class="EliteSIP.App.Incoming.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:history="clr-namespace:EliteSIP.App.History"
        xmlns:incoming="clr-namespace:EliteSIP.App.Incoming"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=incoming:IncomingCallViewModel}"
        Title="{res:Loc IncomingWindowTitle}"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{DynamicResource PanelWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- Карточка без системного заголовка; верхняя строка остаётся областью перетаскивания. -->
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Panel/Graphite.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="28" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <StackPanel Margin="8">
    <DockPanel LastChildFill="False" Cursor="SizeAll">
      <history:OutcomeBadge DockPanel.Dock="Left"
                            IsIncoming="True"
                            IsCompleted="True"
                            Size="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource OutcomeAnsweredBrush}" />

      <TextBlock DockPanel.Dock="Left"
                 Margin="6,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="14"
                 Text="{Binding Caption}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRefused}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DeclineBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <theme:Icon DockPanel.Dock="Right"
                  Glyph="lock.shield.fill"
                  Size="14"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextTertiaryBrush}"
                  AutomationProperties.Name="{res:Loc IncomingGuardOn}"
                  Visibility="{Binding IsGuarded, Converter={StaticResource BoolToVisibility}}" />
    </DockPanel>
    <Border Background="{DynamicResource PanelCallBrush}" CornerRadius="10" Effect="{StaticResource PanelShadow}" Padding="12,16" MinHeight="116" Margin="0,8,0,0">
    <!-- Копируется только видимый номер; маска и обработчик копирования сохранены. -->
    <StackPanel x:Name="NumberBlock"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="{res:Loc IncomingCopyNumber}"
                ToolTipService.IsEnabled="{Binding CanCopyNumber}">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding CanCopyNumber}" Value="True">
              <Setter Property="Cursor" Value="Hand" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock x:Name="CallerHeadline" theme:Emoji.Text="{Binding Headline}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="60" LineHeight="30" LineStackingStrategy="BlockLineHeight"
                 FontSize="25"
                 FontWeight="SemiBold" />

      <TextBlock Text="{Binding SecondaryNumber}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" Margin="0,7,0,0"
                 FontSize="18"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding SecondaryNumber, Converter={StaticResource PresenceToVisibility}}" />
    </StackPanel>
    </Border>
    <StackPanel Margin="0,10,0,0">
      <TextBlock Text="{res:Loc IncomingDealPrompt}"
                 Margin="0,0,0,6"
                 FontSize="15"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding IsSelfCall, Converter={StaticResource BoolToVisibility}}" />
      <!-- Цифровые цели нейтральны и принимают только мышь через прежний путь защиты. -->
      <StackPanel Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="{res:Loc IncomingDigitPrompt}"
                     FontSize="15"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding Answer}"
                     Margin="4,0,0,0"
                     FontSize="15"
                     FontWeight="SemiBold" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Targets}" Margin="-3,0,-3,6">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource PanelSurfaceButtonStyle}"
                      Margin="3,0" Padding="0"
                      Height="50"
                      FontSize="20"
                      Content="{Binding}"
                      Command="{Binding DataContext.AttemptCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      Focusable="False"
                      AutomationProperties.IsOffscreenBehavior="Offscreen" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource PanelCallButtonStyle}" Background="{DynamicResource PanelDeclineBrush}"
                Height="50"
                Command="{Binding DeclineCommand}"
                IsCancel="True"
                AutomationProperties.Name="{res:Loc IncomingDecline}">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="phone.down.fill" Size="14"
                        Foreground="White"
                        VerticalAlignment="Center" />
            <TextBlock Text="{res:Loc IncomingDecline}"
                       Margin="6,0,0,0"
                       FontSize="16"
                       Foreground="White" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Grid Visibility="{Binding HasChoice, Converter={StaticResource NotBoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Ответ слева, отказ справа; параметры команды и ограничения автоматизации прежние. -->
        <Button x:Name="AnswerButton" Grid.Column="0"
                Height="50"
                Background="{DynamicResource PanelAnswerBrush}"
                Command="{Binding AttemptCommand}"
                CommandParameter="{Binding Answer}"
                Focusable="False"
                AutomationProperties.IsOffscreenBehavior="Offscreen">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PanelCallButtonStyle}">
              <Style.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions><Condition Property="IsVisible" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="IsMouseOver" Value="False" /></MultiTrigger.Conditions>
                  <MultiTrigger.EnterActions><BeginStoryboard Name="AnswerPulse"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.87" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                  <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="AnswerPulse" /></MultiTrigger.ExitActions>
                </MultiTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="phone.fill" Size="14" Foreground="White" VerticalAlignment="Center" />
            <TextBlock Text="{res:Loc IncomingAnswer}" Margin="6,0,0,0" FontSize="16" Foreground="White" />
          </StackPanel>
        </Button>

        <Button x:Name="DeclineButton" Grid.Column="2"
                Style="{StaticResource PanelCallButtonStyle}"
                Height="50"
                Background="{DynamicResource PanelDeclineBrush}"
                Command="{Binding DeclineCommand}"
                IsCancel="True"
                AutomationProperties.Name="{res:Loc IncomingDecline}">
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="phone.down.fill" Size="14" Foreground="White" VerticalAlignment="Center" />
            <TextBlock Text="{res:Loc IncomingDecline}" Margin="6,0,0,0" FontSize="16" Foreground="White" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </StackPanel>
</Window>
