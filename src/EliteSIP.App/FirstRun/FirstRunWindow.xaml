<Window x:Class="EliteSIP.App.FirstRun.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:firstrun="clr-namespace:EliteSIP.App.FirstRun"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=firstrun:FirstRunViewModel}"
        Title="{res:Loc FirstRunTitle}"
        Width="460"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        theme:SettingsLayout.LabelColumn="132"
        theme:SettingsLayout.RowMaxWidth="420">

  <!--
      Размер один на все экраны и фиксированный. По «Далее» щёлкают четыре раза
      подряд, и кнопка, переезжающая между шагами, ловит четвёртый щелчок мимо.
      Тот же закон, по которому не двигается «Завершить» на панели.

      Высота 440 и шаги по центру. На 500 с шагами у верха (0.1.59) под
      приветствием и оформлением стояла пустота в полокна. Самый высокий шаг —
      ручная настройка: шесть строк, разделитель и две сноски; он начинается
      у верха без отступа, и в 440 помещается. Если текст окажется длиннее
      (другой язык, будущий шаг), появится прокрутка, а не срезанные поля —
      `Grid` молча отдаёт содержимому меньше места и ничего не сообщает.
      Проверяется тестом FirstRunLayoutTests.
  -->

  <Window.Resources>
    <!--
        Строки мастера — подписью слева, а не сверху, как в «Управлении».
        Сверху шесть полей занимали 360 точек и не влезали ни в 440, ни в
        прежние 500: шаг ручной настройки уходил под прокрутку, и нижние поля
        с паролем администратора оказывались за краем. Поле здесь короткое,
        и места слева под подпись хватает.
    -->
    <Style TargetType="{x:Type theme:SettingsRow}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type theme:SettingsRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Header}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <ContentPresenter Grid.Column="1" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
        Прокрутка — не про сегодняшний шаг, а про то, чтобы срезать перестало
        когда-либо. Высоты хватает всем шагам с запасом, и полосы прокрутки в
        обычной жизни не видно; появится она у того, у кого текст окажется
        длиннее нашего — на другом языке или на будущем шаге.

        `MinHeight` по высоте окна прокрутки — ради центрирования: внутри
        прокрутки содержимое получает бесконечную высоту, и `VerticalAlignment`
        у коротких шагов перестал бы работать, прижав приветствие к верху.
    -->
    <ScrollViewer Grid.Row="0"
                  x:Name="StepScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=StepScroll}">

      <!-- 1. Приветствие и язык. -->
      <StackPanel VerticalAlignment="Center"
                  Visibility="{Binding ShowsWelcome, Converter={StaticResource BoolToVisibility}}">
        <theme:Icon Glyph="phone.fill" Size="40" HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock Text="{res:Loc FirstRunWelcomeTitle}"
                   Margin="0,12,0,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextAlignment="Center" />

        <TextBlock Text="{res:Loc FirstRunWelcomeSubtitle}"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
          <RadioButton Style="{StaticResource SegmentStyle}" GroupName="WizardLanguage"
                       Content="{res:Loc AppearanceLanguageSystem}"
                       IsChecked="{Binding Language, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
          <RadioButton Style="{StaticResource SegmentStyle}" GroupName="WizardLanguage" Content="Русский"
                       IsChecked="{Binding Language, Converter={StaticResource EnumToBool}, ConverterParameter=Russian}" />
          <RadioButton Style="{StaticResource SegmentStyle}" GroupName="WizardLanguage" Content="English"
                       IsChecked="{Binding Language, Converter={StaticResource EnumToBool}, ConverterParameter=English}" />
        </StackPanel>

        <TextBlock Text="{res:Loc FirstRunLanguageNote}"
                   Margin="0,8,0,0"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <!--
          2. Привязка.

          Ключей активации нет: машина показывает код и QR, администратор
          вводит код в Spark или сканирует QR в EliteSIP Connect. Дальше машина
          настраивается сама. Код крупно — его диктуют по телефону; QR рядом —
          его сканируют с метра. «Далее» неактивно до привязки, уводит отсюда
          без неё только «Настроить вручную».
      -->
      <StackPanel VerticalAlignment="Center"
                  Visibility="{Binding ShowsPair, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{res:Loc FirstRunPairTitle}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center" />

        <TextBlock Text="{res:Loc FirstRunPairSubtitle}"
                   Margin="0,4,0,12"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasPairCode, Converter={StaticResource BoolToVisibility}}">
          <!-- Белая подложка при любой теме: сканеры читают тёмное на светлом. -->
          <Border Background="White" CornerRadius="4" Padding="4">
            <Image Source="{Binding PairQr}"
                   Width="132" Height="132"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
          </Border>

          <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{res:Loc FirstRunPairCodeLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding PairCode}"
                       FontFamily="Consolas"
                       FontSize="34"
                       FontWeight="SemiBold" />
            <Button Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="{res:Loc FirstRunPairNewCode}"
                    Click="OnNewCodeClick" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding PairStatus}"
                   Margin="24,16,24,0"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasPairStatus, Converter={StaticResource BoolToVisibility}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding PairFailed}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!--
            Заводской настройки нет — говорим об этом здесь, а не пропускаем
            экран. Пропуск был молчаливым, и машина, навсегда отрезанная от
            Spark, выглядела бы просто заведённой вручную.
        -->
        <TextBlock Text="{res:Loc FirstRunKeyNoChannel}"
                   Margin="24,12,24,0"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource CautionBrush}"
                   Visibility="{Binding HasNoChannel, Converter={StaticResource BoolToVisibility}}" />

        <!--
            Кому привязали — до «Далее», а не после: человек обязан увидеть,
            чьё это рабочее место, прежде чем оно станет его.
        -->
        <StackPanel Margin="0,10,0,0"
                    Visibility="{Binding IsPaired, Converter={StaticResource BoolToVisibility}}">
          <theme:Icon Glyph="checkmark.circle" Size="28" HorizontalAlignment="Center"
                      Foreground="{DynamicResource AnswerBrush}" />
          <TextBlock Text="{Binding PairedEmployee}"
                     Margin="0,6,0,0"
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextAlignment="Center" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="12"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding PairedNumber}" />
        </StackPanel>

        <Button Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SettingsButtonStyle}"
                Content="{res:Loc FirstRunKeyManual}"
                Click="OnManualSetupClick" />
      </StackPanel>

      <!-- 3. Первый пользователь. -->
      <StackPanel VerticalAlignment="Top"
                  Visibility="{Binding ShowsUser, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{res:Loc FirstRunUserTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{res:Loc FirstRunUserSubtitle}"
                   Margin="0,4,0,10"
                   FontSize="12"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <theme:SettingsRow Header="{res:Loc AdminAccountUsername}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <TextBox Style="{StaticResource PanelTextBoxStyle}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsRow Header="{res:Loc AdminAccountPassword}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <PasswordBox x:Name="SipPasswordField"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         PasswordChanged="OnSipPasswordChanged" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsRow Header="{res:Loc AdminAccountDisplayName}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <TextBox Style="{StaticResource PanelTextBoxStyle}"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsRow Header="{res:Loc WorkPbxAddress}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <TextBox Style="{StaticResource PanelTextBoxStyle}"
                     Text="{Binding OfficeAddress, UpdateSourceTrigger=PropertyChanged}" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsDivider />

        <theme:SettingsRow Header="{res:Loc AdminAccessNewPassword}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <PasswordBox x:Name="AdminPasswordField"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         PasswordChanged="OnAdminPasswordChanged" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsRow Header="{res:Loc AdminAccessRepeatPassword}">
          <Border Height="26" CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,0" Background="{DynamicResource ControlBackgroundBrush}">
            <PasswordBox x:Name="RepeatedAdminPasswordField"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         PasswordChanged="OnRepeatedAdminPasswordChanged" />
          </Border>
        </theme:SettingsRow>

        <theme:SettingsNote Text="{res:Loc AdminAccessMismatch}"
                            IsAlarming="True"
                            Visibility="{Binding AdminPasswordsDiffer, Converter={StaticResource BoolToVisibility}}" />

        <theme:SettingsNote Text="{res:Loc FirstRunAdminNote}" />
      </StackPanel>

      <!-- 3. Оформление. -->
      <StackPanel VerticalAlignment="Center"
                  Visibility="{Binding ShowsAppearance, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{res:Loc SectionAppearance}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{res:Loc FirstRunAppearanceSubtitle}"
                   Margin="0,4,0,14"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <RadioButton Style="{StaticResource ThemeTileStyle}" Tag="System" GroupName="WizardTheme"
                       Content="{res:Loc AppearanceSystem}"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
          <RadioButton Style="{StaticResource ThemeTileStyle}" Tag="Light" GroupName="WizardTheme"
                       Content="{res:Loc AppearanceLight}"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}" />
          <RadioButton Style="{StaticResource ThemeTileStyle}" Tag="Dark" GroupName="WizardTheme"
                       Content="{res:Loc AppearanceDark}"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}" />
        </StackPanel>
      </StackPanel>

      <!-- 4. Готово. -->
      <StackPanel VerticalAlignment="Center"
                  Visibility="{Binding ShowsFinale, Converter={StaticResource BoolToVisibility}}">
        <theme:Icon Glyph="checkmark.circle" Size="40" HorizontalAlignment="Center"
                    Foreground="{DynamicResource StatusRegisteredBrush}" />

        <TextBlock Text="{res:Loc FirstRunFinaleTitle}"
                   Margin="0,12,0,0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextAlignment="Center" />

        <!--
            Сводка коротко и без пароля: она отвечает на «то ли я завёл», а не
            заменяет собой «Управление».
        -->
        <TextBlock Margin="0,10,0,0" FontSize="13" TextAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}">
          <Run Text="{res:Loc AdminAccountUsername}" /><Run Text=": " /><Run Text="{Binding Username}" />
          <LineBreak />
          <Run Text="{res:Loc WorkPbxAddress}" /><Run Text=": " /><Run Text="{Binding OfficeAddress}" />
        </TextBlock>

        <TextBlock Text="{res:Loc FirstRunFinaleNote}"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Полоса шагов: отделена линией, как нижняя полоса диалогов Windows. -->
    <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Margin="-16,0,-16,0"
            Background="{DynamicResource SeparatorBrush}" />
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Style="{StaticResource SettingsButtonStyle}"
              Content="{res:Loc FirstRunBack}"
              IsEnabled="{Binding CanGoBack}"
              Click="OnBackClick" />

      <Button Grid.Column="2"
              Style="{StaticResource SettingsButtonStyle}"
              MinWidth="90"
              IsEnabled="{Binding CanGoForward}"
              Click="OnForwardClick">
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{res:Loc FirstRunNext}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                  <Setter Property="Text" Value="{res:Loc FirstRunFinish}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>
    </Grid>
  </Grid>
</Window>
