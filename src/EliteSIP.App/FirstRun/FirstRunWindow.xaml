<Window x:Class="EliteSIP.App.FirstRun.FirstRunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:EliteSIP.App.Theme" xmlns:res="clr-namespace:EliteSIP.App.Resources" xmlns:settings="clr-namespace:EliteSIP.App.Settings" Title="{res:Loc FirstRunTitle}" Width="560" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Style="{DynamicResource SettingsDialogWindowStyle}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Settings/SettingsDialogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="WizardField" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsFieldBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,3,0,0" />
      </Style>
      <Style x:Key="WizardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="WizardStep" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="18,8,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{res:Loc AdminConnection}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource WizardStep}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowsConnection}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <theme:Icon Grid.Column="1" Glyph="settings.arrow-right" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Grid.Column="2" Text="{res:Loc SectionAppearance}" HorizontalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource WizardStep}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowsAppearance}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <theme:Icon Grid.Column="3" Glyph="settings.arrow-right" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Grid.Column="4" Text="{res:Loc FirstRunFinaleTitle}" HorizontalAlignment="Right">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource WizardStep}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowsFinale}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="132" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" SelectedValue="{Binding Language}" SelectedValuePath="Tag" VerticalAlignment="Center" Height="30" Visibility="{Binding ShowsConnection, Converter={StaticResource BoolToVisibility}}" ToolTip="{res:Loc AppearanceLanguage}">
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.System}" Content="{res:Loc AppearanceLanguageSystem}" />
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.Russian}" Content="Русский" />
        <ComboBoxItem Tag="{x:Static settings:LanguageSetting.English}" Content="English" />
      </ComboBox>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SettingsContentScrollViewerStyle}">
      <Grid>
        <StackPanel Visibility="{Binding ShowsConnection, Converter={StaticResource BoolToVisibility}}">
          <Border Background="{DynamicResource SettingsTrackBrush}" CornerRadius="9" Padding="3" Margin="0,3,0,10">
            <UniformGrid Columns="2">
              <RadioButton Style="{StaticResource SettingsSegmentStyle}" Content="{res:Loc WizardSpark}" IsChecked="{Binding ShowsPairing, Mode=OneWay}" Click="OnSparkSetupClick" />
              <RadioButton Style="{StaticResource SettingsSegmentStyle}" Content="{res:Loc WizardManual}" IsChecked="{Binding ShowsUser, Mode=OneWay}" IsEnabled="{Binding IsPaired, Converter={StaticResource NotBool}}" Click="OnManualSetupClick" />
            </UniformGrid>
          </Border>
          <StackPanel Visibility="{Binding ShowsPairing, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource SettingsDialogCardStyle}" Visibility="{Binding IsPaired, Converter={StaticResource NotBoolToVisibility}}">
              <StackPanel>
                <Grid Visibility="{Binding HasPairCode, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Background="White" CornerRadius="7" Padding="4">
                    <Image Source="{Binding PairQr}" Width="112" Height="112" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{res:Loc FirstRunPairCodeLabel}" Style="{StaticResource WizardLabel}" />
                    <TextBlock Text="{Binding PairCode}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Click="OnNewCodeClick">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.refresh-cw" Size="14" />
                        <TextBlock Text="{res:Loc FirstRunPairNewCode}" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding HasNoChannel, Converter={StaticResource BoolToVisibility}}" Margin="0,6">
                  <theme:Icon Glyph="settings.cloud" Size="28" HorizontalAlignment="Center" />
                  <TextBlock Text="{res:Loc FirstRunKeyNoChannel}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,10,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                  <theme:Icon Glyph="settings.monitor" Size="18" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" Margin="6,0,12,0" Style="{StaticResource WizardLabel}" VerticalAlignment="Center" />
                  <theme:Icon Glyph="settings.arrow-right" Size="14" VerticalAlignment="Center" />
                  <theme:Icon Glyph="settings.cloud" Size="18" Margin="12,0,6,0" />
                  <TextBlock Text="Spark" Style="{StaticResource WizardLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsDialogCardStyle}" Visibility="{Binding IsPaired, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{res:Loc WizardPaired}" Foreground="{DynamicResource SettingsGreenBrush}" FontSize="12" />
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.monitor" Size="16" />
                    <TextBlock Text="{res:Loc WorkPlace}" Margin="7,0,0,0" Style="{StaticResource WizardLabel}" />
                  </StackPanel>
                </DockPanel>
                <Grid Margin="0,21">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ProfileNumber}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileLabel}" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{res:Loc WizardFromSpark}" Style="{StaticResource WizardLabel}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <theme:Icon Glyph="settings.cloud" Size="17" />
                  <TextBlock Text="Spark" Margin="6,0,15,0" Style="{StaticResource WizardLabel}" />
                  <theme:Icon Glyph="settings.arrow-left-right" Size="16" Foreground="{DynamicResource SettingsGreenBrush}" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" Style="{StaticResource WizardLabel}" Margin="15,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding PairStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Visibility="{Binding HasPairStatus, Converter={StaticResource BoolToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PairFailed}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <Border Padding="12" Style="{StaticResource SettingsDialogCardStyle}" Visibility="{Binding ShowsUser, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="24" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{res:Loc AdminAccountUsername}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{res:Loc AdminProfileLabel}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="{res:Loc WorkPbxAddress}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding OfficeAddress, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="{res:Loc AdminAccountPassword}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <PasswordBox x:Name="SipPasswordField" PasswordChanged="OnSipPasswordChanged" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                <theme:Icon Glyph="settings.lock-keyhole" Size="14" />
                <TextBlock Text="{res:Loc WizardAdminOptional}" Style="{StaticResource WizardLabel}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="3">
                <TextBlock Text="{res:Loc AdminAccessNewPassword}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <PasswordBox x:Name="AdminPasswordField" PasswordChanged="OnAdminPasswordChanged" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="2">
                <TextBlock Text="{res:Loc AdminAccessRepeatPassword}" Style="{StaticResource WizardLabel}" />
                <Border Style="{StaticResource WizardField}">
                  <PasswordBox x:Name="RepeatedAdminPasswordField" PasswordChanged="OnRepeatedAdminPasswordChanged" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{res:Loc AdminAccessMismatch}" FontSize="11" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap" Visibility="{Binding AdminPasswordsDiffer, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel Visibility="{Binding ShowsAppearance, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SettingsDialogCardStyle}">
            <StackPanel>
              <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource SettingsThemeTileStyle}" Tag="System" GroupName="WizardTheme" Content="{res:Loc AppearanceSystem}" IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource SettingsThemeTileStyle}" Tag="Light" GroupName="WizardTheme" Content="{res:Loc AppearanceLight}" IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}" />
                <RadioButton Style="{StaticResource SettingsThemeTileStyle}" Tag="Dark" GroupName="WizardTheme" Content="{res:Loc AppearanceDark}" IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}" />
              </UniformGrid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,3">
                <theme:Icon Glyph="settings.panels-top-left" Size="16" />
                <TextBlock Text="{res:Loc WizardThemeLive}" Style="{StaticResource WizardLabel}" Margin="7,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Visibility="{Binding ShowsFinale, Converter={StaticResource BoolToVisibility}}">
          <Grid Margin="4,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelWindowBackgroundBrush}" BorderBrush="{DynamicResource SettingsEdgeBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Effect="{StaticResource SettingsSurfaceShadow}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <theme:Icon Glyph="settings.crown-split" Size="13" />
                  <TextBlock Text="EliteSIP" FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
                <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="10" Padding="6,3" HorizontalAlignment="Left" MaxWidth="158">
                  <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProfileNumber, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding ProfileLabel, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="7" Padding="9,13" Margin="0,7">
                  <TextBlock Text="{res:Loc PanelNumberPlaceholder}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                  <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="6" Padding="3,10" Margin="0,0,3,0">
                    <theme:Icon Glyph="settings.mic" Size="12" />
                  </Border>
                  <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="6" Padding="3,10" Margin="3,0,0,0">
                    <theme:Icon Glyph="settings.headset" Size="12" />
                  </Border>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                  <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="6" Height="39" Margin="0,0,3,0" />
                  <Border Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="6" Height="39" Margin="3,0,0,0" />
                </UniformGrid>
                <Border Background="{DynamicResource AnswerFillBrush}" CornerRadius="6" Padding="5,9">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <theme:Icon Glyph="phone.fill" Size="12" Foreground="White" />
                    <TextBlock Text="{res:Loc PanelCall}" FontSize="11" Foreground="White" Margin="6,0,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{res:Loc WorkPlace}" Style="{StaticResource WizardLabel}" />
              <TextBlock Text="{Binding ProfileNumber}" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,3" />
              <TextBlock Text="{Binding ProfileLabel}" FontSize="16" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProfileSource}" Style="{StaticResource WizardLabel}" Margin="0,17,0,0" />
              <TextBlock Text="{res:Loc WizardLaunchNote}" Style="{StaticResource WizardLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,8,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding FooterNote}" Style="{StaticResource WizardLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
      <Button Grid.Column="1" Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc FirstRunBack}" IsEnabled="{Binding CanReturn}" Click="OnBackClick" />
      <Button Grid.Column="3" x:Name="ForwardButton" Style="{StaticResource SettingsButtonStyle}" IsEnabled="{Binding CanGoForward}" Width="132" Click="OnForwardClick">
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{res:Loc FirstRunNext}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                  <Setter Property="Text" Value="{res:Loc FirstRunFinish}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>
    </Grid>
  </Grid>
</Window>