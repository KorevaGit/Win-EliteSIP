<Window x:Class="EliteSIP.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:settings="clr-namespace:EliteSIP.App.Settings"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
        Title="{res:Loc SettingsWindowTitle}"
        Width="660"
        Height="480"
        MinWidth="660"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        theme:SettingsLayout.LabelColumn="72"
        theme:SettingsLayout.RowMaxWidth="420">

  <!--
      Ширина 620 — сайдбар 160 плюс строка во всю свою ширину плюс поля.
      Высота 420 задаётся содержимым: разделов пять, и они видны на любой
      высоте, а самый высокий — «Звук» с двумя устройствами и самопроверкой.

      Колонка подписей — менеджерские 72, а не административные 132: подписи
      здесь короткие («Громкость», «Микрофон»), и широкая колонка отодвинула бы
      управление от левого края на пустое место.
  -->

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Сайдбар фиксирован: список не тянется вместе с окном, иначе на
           широком мониторе пять коротких названий разъезжаются по полосе в
           треть экрана. -->
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Боковой список разделов. -->

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <ListBox ItemsSource="{Binding Sections}"
               SelectedValue="{Binding Section}"
               SelectedValuePath="Kind"
               Background="Transparent"
               BorderThickness="0"
               Margin="0,8,0,8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <!--
                      Выбранный раздел — текст и значок акцентным цветом, без
                      заливки: так отмечает выбранное список Параметров
                      Windows 10. Под курсором строка чуть светлеет.
                  -->
                  <Grid x:Name="Row" Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type settings:SettingsSectionItem}">
            <StackPanel Orientation="Horizontal">
              <!-- Значок 15, а не системные 16: наши нарисованы на сетке 20×20
                   обводкой 1.5 и на шестнадцати читаются грубее соседей. -->
              <!-- Цвет значка — цвет строки: у выбранной он акцентный. -->
              <theme:Icon Glyph="{Binding Glyph}" Size="16" VerticalAlignment="Center"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Открытый раздел и полоса низа. -->

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="24,16,24,0">
        <!--
            Потолок ширины строк задан здесь, столбцу разделов, а не каждой
            строке порознь. Порознь не выходит: строке с ползунком нужно
            тянуться до потолка, а элемент, который и тянется, и ограничен
            сверху, WPF ставит по середине оставшегося места — на широком окне
            раздел уезжал бы от левого края.
        -->
        <Grid HorizontalAlignment="Left"
              Width="{Binding (theme:SettingsLayout.RowMaxWidth), RelativeSource={RelativeSource Self}}">

          <!-- Раздел «Работа». -->
          <StackPanel Visibility="{Binding ShowsWork, Converter={StaticResource BoolToVisibility}}">
            <theme:SettingsSection Header="{res:Loc WorkPlace}">
              <theme:SettingsRow Header="{res:Loc SectionWork}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Site"
                               Content="{res:Loc WorkOffice}"
                               IsChecked="{Binding Settings.Account.Site, Converter={StaticResource EnumToBool}, ConverterParameter=Office}" />
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Site"
                               Content="{res:Loc WorkRemote}"
                               IsChecked="{Binding Settings.Account.Site, Converter={StaticResource EnumToBool}, ConverterParameter=Remote}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc WorkPbxAddress}">
                <TextBlock Text="{Binding Settings.Account.Domain}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc WorkSiteNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc WorkTroubleSection}">
              <theme:SettingsIndented>
                <TextBlock Text="{res:Loc WorkRepairNote}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsIndented>

              <theme:SettingsIndented>
                <Button Style="{StaticResource SettingsButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="{res:Loc WorkRepairNetwork}"
                        Command="{Binding RepairNetwork}" />
              </theme:SettingsIndented>

              <!-- Итог — здесь, под своей кнопкой: прежде он уходил на страницу
                   «Техподдержка», и нажатие на этой странице выглядело ничем. -->
              <theme:SettingsNote Text="{Binding SupportResult}"
                                  Visibility="{Binding HasNetworkResult,
                                                       Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Звук». -->
          <StackPanel Visibility="{Binding ShowsAudio, Converter={StaticResource BoolToVisibility}}">
            <!--
                Четыре группы вместо одной сплошной: микрофон, наушники,
                обработка и проверка — разные вопросы, и одной стопкой они
                читались как список без начала и конца.
            -->
            <theme:SettingsSection Header="{res:Loc AudioInputSection}">
              <theme:SettingsRow Header="{res:Loc AudioDevice}">
                <!--
                    Шаблон строки, а не `DisplayMemberPath`: закрытый вид
                    своего списка рисуется тем же `SelectionBoxItemTemplate`,
                    а `DisplayMemberPath` его не заполняет — в закрытом списке
                    оказывалось имя типа со всеми полями, что живая проверка и
                    показала.
                -->
                <ComboBox ItemsSource="{Binding Inputs}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Settings.Audio.InputDeviceId}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </theme:SettingsRow>

              <!--
                  Ползунок стоит под своим устройством, а не отдельным блоком
                  «Громкость» внизу страницы: отдельным блоком обе подписи
                  пришлось бы называть «Микрофон» и «Наушники» второй раз.
              -->
              <theme:SettingsRow Header="{res:Loc AudioGain}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="0" Maximum="2"
                          SmallChange="0.05" LargeChange="0.1"
                          VerticalAlignment="Center"
                          Value="{Binding Settings.Audio.MicrophoneGain}"
                          IsEnabled="{Binding Settings.Audio.GainIsAdjustable}" />
                  <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             MinWidth="40"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Settings.Audio.MicrophoneGain, Converter={StaticResource Percent}}" />
                </Grid>
              </theme:SettingsRow>

              <!--
                  Почему ручка серая — здесь, а не подсказкой при наведении:
                  «управление серое и молчит» — худший вид отказа.
              -->
              <theme:SettingsNote Text="{res:Loc AudioGainAutoNote}"
                                  Visibility="{Binding Settings.Audio.AutomaticGainControl, Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AudioOutputSection}">
              <theme:SettingsRow Header="{res:Loc AudioDevice}">
                <ComboBox ItemsSource="{Binding Outputs}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Settings.Audio.OutputDeviceId}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </theme:SettingsRow>

              <!-- Выше единицы не идёт: микшер громче не умеет. -->
              <theme:SettingsRow Header="{res:Loc AudioVolume}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="0" Maximum="1"
                          SmallChange="0.05" LargeChange="0.1"
                          VerticalAlignment="Center"
                          Value="{Binding Settings.Audio.PlaybackVolume}" />
                  <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             MinWidth="40"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Settings.Audio.PlaybackVolume, Converter={StaticResource Percent}}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AudioLevelsNote}" />

              <theme:SettingsNote Text="{res:Loc AudioAggregateNote}"
                                  Visibility="{Binding NeedsAggregate, Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc AudioProcessingSection}">
              <CheckBox Style="{StaticResource SettingsSwitchStyle}"
                        Content="{res:Loc AudioAgc}"
                        IsChecked="{Binding Settings.Audio.AutomaticGainControl}" />

              <CheckBox Style="{StaticResource SettingsSwitchStyle}"
                        Content="{res:Loc AudioNoiseSuppression}"
                        IsChecked="{Binding Settings.Audio.NoiseSuppression}" />

              <theme:SettingsNote Text="{res:Loc AudioNoiseSuppressionNote}" />

              <CheckBox Style="{StaticResource SettingsSwitchStyle}"
                        Content="{res:Loc AudioRelease}"
                        IsChecked="{Binding Settings.Audio.ReleasesDeviceWhenIdle}" />
            </theme:SettingsSection>

            <!--
                Самопроверка звука — см. `AudioSelfTest`. Пояснение над кнопкой
                (что будет), итог — под ней (что вышло).
            -->
            <theme:SettingsSection Header="{res:Loc AudioSelfTestSection}">
              <theme:SettingsIndented>
                <TextBlock Text="{res:Loc AudioSelfTestNote}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsIndented>

              <!-- Одна кнопка на запуск и остановку: вторая рядом читалась бы
                   как ещё одна проверка. -->
              <theme:SettingsIndented>
                <Button Style="{StaticResource SettingsButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="{Binding SelfTestButtonText}"
                        IsEnabled="{Binding CanRunSelfTest}"
                        Command="{Binding RunSelfTest}" />
              </theme:SettingsIndented>

              <!-- Серая кнопка без объяснения — худший вид отказа. -->
              <theme:SettingsNote Text="{res:Loc AudioSelfTestBusy}"
                                  Visibility="{Binding IsSelfTestBlockedByCall,
                                                       Converter={StaticResource BoolToVisibility}}" />

              <!--
                  Шкалы — только во время проверки и разговора. В остальное
                  время подсказка: полоса на нуле читается как сломанный
                  микрофон, а открывать микрофон ради шкалы нельзя.
              -->
              <theme:SettingsRow Header="{res:Loc AudioMeterVoice}"
                                 Visibility="{Binding ShowsMeters, Converter={StaticResource BoolToVisibility}}">
                <theme:LevelMeter Level="{Binding VoiceLevel}" VerticalAlignment="Center" />
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AudioMeterSound}"
                                 Visibility="{Binding ShowsMeters, Converter={StaticResource BoolToVisibility}}">
                <theme:LevelMeter Level="{Binding SoundLevel}" VerticalAlignment="Center" />
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AudioMeterHint}"
                                  Visibility="{Binding ShowsMeters, Converter={StaticResource NotBoolToVisibility}}" />

              <theme:SettingsNote Text="{Binding SelfTestResult}"
                                  Visibility="{Binding HasSelfTestResult,
                                                       Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Звонок». -->
          <StackPanel Visibility="{Binding ShowsRingtone, Converter={StaticResource BoolToVisibility}}">
            <theme:SettingsSection Header="{res:Loc SectionRingtone}">
              <CheckBox Style="{StaticResource SettingsSwitchStyle}"
                        Content="{res:Loc RingtoneEnabled}"
                        IsChecked="{Binding Settings.Ringtone.IsEnabled}" />

              <!--
                  Гаснет весь раздел, кроме собственного выключателя: он и есть
                  то, чем раздел возвращают.
              -->
              <theme:SettingsRow Header="{res:Loc AudioVolume}"
                                 IsEnabled="{Binding Settings.Ringtone.IsEnabled}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="0" Maximum="1"
                          SmallChange="0.05" LargeChange="0.1"
                          VerticalAlignment="Center"
                          Value="{Binding Settings.Ringtone.Volume}" />
                  <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             MinWidth="40"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Settings.Ringtone.Volume, Converter={StaticResource Percent}}" />
                </Grid>
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc RingtonePlayIn}"
                                 IsEnabled="{Binding Settings.Ringtone.IsEnabled}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="RingtoneOutput"
                               Content="{res:Loc RingtoneSystemOutput}"
                               IsChecked="{Binding Settings.Ringtone.Output, Converter={StaticResource EnumToBool}, ConverterParameter=SystemDefault}" />
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="RingtoneOutput"
                               Content="{res:Loc RingtoneCallOutput}"
                               IsChecked="{Binding Settings.Ringtone.Output, Converter={StaticResource EnumToBool}, ConverterParameter=CallDevice}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc RingtoneOutputNote}" />

              <theme:SettingsRow Header="{res:Loc RingtoneSound}"
                                 IsEnabled="{Binding Settings.Ringtone.IsEnabled}">
                <TextBlock Text="{Binding RingtoneName}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsIndented IsEnabled="{Binding Settings.Ringtone.IsEnabled}">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SettingsButtonStyle}"
                          Content="{res:Loc RingtoneChooseFile}"
                          Click="OnChooseRingtoneClick" />
                  <Button Style="{StaticResource SettingsButtonStyle}"
                          Margin="12,0,0,0"
                          Content="{res:Loc RingtoneDefault}"
                          Click="OnDefaultRingtoneClick"
                          IsEnabled="{Binding Settings.Ringtone.HasCustomSound}" />
                  <Button Style="{StaticResource SettingsButtonStyle}"
                          Margin="12,0,0,0"
                          Content="{res:Loc RingtonePreview}"
                          Click="OnPreviewRingtoneClick" />
                </StackPanel>
              </theme:SettingsIndented>

              <theme:SettingsNote x:Name="RingtoneProblem"
                                  IsAlarming="True"
                                  Visibility="Collapsed" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Оформление». -->
          <StackPanel Visibility="{Binding ShowsAppearance, Converter={StaticResource BoolToVisibility}}">
            <!--
                Раздел был из одной строки, и это не считалось недосмотром:
                панель висит поверх CRM весь день, и если CRM светлая, а система
                тёмная, выбор делает тот, кто на это смотрит.
            -->
            <theme:SettingsSection Header="{res:Loc SectionAppearance}">
              <theme:SettingsRow Header="{res:Loc AppearanceTheme}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Theme"
                               Content="{res:Loc AppearanceSystem}"
                               IsChecked="{Binding Settings.Appearance.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Theme"
                               Content="{res:Loc AppearanceLight}"
                               IsChecked="{Binding Settings.Appearance.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}" />
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Theme"
                               Content="{res:Loc AppearanceDark}"
                               IsChecked="{Binding Settings.Appearance.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}" />
                </StackPanel>
              </theme:SettingsRow>

              <!--
                  Тема применяется сразу, и это отличие от оригинала не
                  косметическое: там переключение корпуса требовало перезапуска,
                  потому что стекло выбиралось при сборке окон. Здесь палитра —
                  словарь ресурсов, и подменяется он на живых окнах.
              -->
              <theme:SettingsNote Text="{res:Loc AppearanceThemeNote}" />
            </theme:SettingsSection>

            <!--
                Свой раздел, а не строка рядом с темой. Язык не оформление: тема
                решает, как приложение выглядит, а язык — на чём оно
                разговаривает, и меняют его один раз при заведении рабочего
                места, а не по настроению.
            -->
            <theme:SettingsSection Header="{res:Loc AppearanceLanguage}">
              <theme:SettingsRow Header="">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Language"
                               Content="{res:Loc AppearanceLanguageSystem}"
                               Checked="OnLanguageChosen"
                               Tag="System"
                               IsChecked="{Binding Settings.Appearance.Language, Converter={StaticResource EnumToBool}, ConverterParameter=System, Mode=OneWay}" />
                  <!-- Названия языков написаны на них самих, как в «Языке и
                       регионе» самой системы: человек, у которого приложение
                       говорит на незнакомом ему языке, ищет в списке слово,
                       которое узнаёт, а не перевод этого слова. -->
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Language"
                               Content="Русский"
                               Checked="OnLanguageChosen"
                               Tag="Russian"
                               IsChecked="{Binding Settings.Appearance.Language, Converter={StaticResource EnumToBool}, ConverterParameter=Russian, Mode=OneWay}" />
                  <RadioButton Style="{StaticResource SegmentStyle}"
                               GroupName="Language"
                               Content="English"
                               Checked="OnLanguageChosen"
                               Tag="English"
                               IsChecked="{Binding Settings.Appearance.Language, Converter={StaticResource EnumToBool}, ConverterParameter=English, Mode=OneWay}" />
                </StackPanel>
              </theme:SettingsRow>

              <theme:SettingsNote Text="{res:Loc AppearanceLanguageNote}" />
              <theme:SettingsNote Text="{res:Loc AppearanceLanguageRestartNote}" />
            </theme:SettingsSection>
          </StackPanel>

          <!-- Раздел «Техподдержка». -->
          <StackPanel Visibility="{Binding ShowsSupport, Converter={StaticResource BoolToVisibility}}">
            <!--
                Три группы вместо одной с чертой посередине: журнал, версия с
                обновлениями и предустановки — три разных разговора с
                поддержкой, и у каждой кнопки свой итог прямо под ней.
            -->
            <theme:SettingsSection Header="{res:Loc WorkStartupSection}">
              <CheckBox Style="{StaticResource SettingsSwitchStyle}"
                        Content="{res:Loc AdminMaintenanceAutoStart}"
                        IsChecked="{Binding StartsWithWindows}" />

              <theme:SettingsNote Text="{res:Loc AdminMaintenanceAutoStartNote}" />
            </theme:SettingsSection>

            <theme:SettingsSection Header="{res:Loc SupportLogsSection}">
              <theme:SettingsIndented>
                <TextBlock Text="{res:Loc SupportArchiveNote}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsIndented>

              <theme:SettingsIndented>
                <Button Style="{StaticResource SettingsButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="{res:Loc SupportCollectLogs}"
                        Command="{Binding CollectLogs}" />
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{Binding SupportResult}"
                                  Visibility="{Binding HasLogsResult,
                                                       Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>

            <!--
                Версия — прямо над проверкой обновлений: первое, что просит
                поддержка по телефону, — «какая у вас версия».
            -->
            <theme:SettingsSection Header="{res:Loc SupportUpdatesSection}">
              <theme:SettingsRow Header="{res:Loc SupportVersion}">
                <TextBlock Text="{Binding Version}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <!--
                  Весь блок висит на самом `Updates`, а не на его свойствах:
                  без заводской настройки линии нет, и привязки к её свойствам
                  не разрешались бы — «Установить обновление» висело бы всегда.
              -->
              <StackPanel DataContext="{Binding Updates}"
                          Visibility="{Binding Converter={StaticResource PresenceToVisibility}}">
                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Content="{res:Loc SupportCheckUpdates}"
                            Command="{Binding CheckNow}" />

                    <!-- Только когда выпуск скачан и проверен. -->
                    <Button Style="{StaticResource SettingsButtonStyle}"
                            Margin="12,0,0,0"
                            Content="{res:Loc AdminDiagnosticsInstallUpdate}"
                            Command="{Binding Install}"
                            Visibility="{Binding IsReady,
                                                 Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </theme:SettingsIndented>

                <theme:SettingsNote Text="{Binding Status}"
                                    Visibility="{Binding HasStatus,
                                                         Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </theme:SettingsSection>

            <!--
                Предустановки — своя группа: «почему у меня старые клавиши» и
                «почему у меня старая версия» — два разных вопроса.
            -->
            <!--
                Связь со Spark. Ключей активации больше нет: номер и
                предустановку меняют в карточке сотрудника в Spark, машина
                применяет их сама. Здесь остаётся, по чему её найти в Spark, и
                одна кнопка: проверить сейчас — или, в оффлайне, вернуться в
                онлайн. Раньше машина вне панели этой группы не видела вовсе.
            -->
            <theme:SettingsSection Header="{res:Loc SupportSparkSection}">
              <theme:SettingsRow Header="{res:Loc AdminSupportMachine}">
                <TextBlock Text="{Binding MachineID}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsRow Header="{res:Loc AdminSupportLink}">
                <TextBlock Text="{Binding LinkState}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>

              <theme:SettingsIndented>
                <Grid>
                  <Button Style="{StaticResource SettingsButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="{res:Loc SupportCheckPresets}"
                          Command="{Binding CheckPresets}"
                          Visibility="{Binding IsPanelOffline, Converter={StaticResource NotBoolToVisibility}}" />
                  <Button Style="{StaticResource SettingsButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="{res:Loc SupportReturnOnline}"
                          Command="{Binding ReturnOnline}"
                          Visibility="{Binding IsPanelOffline, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </theme:SettingsIndented>

              <theme:SettingsNote Text="{res:Loc SupportReturnOnlineNote}"
                                  Visibility="{Binding IsPanelOffline, Converter={StaticResource BoolToVisibility}}" />

              <theme:SettingsNote Text="{Binding SupportResult}"
                                  Visibility="{Binding HasPresetsResult,
                                                       Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!--
          Полоса низа — не про сохранение: менеджерские настройки применяются
          сразу, и кнопок «Сохранить» с «Отменить» тут нет и быть не может.
          Полосу занимает дверь в «Управление» — единственное в этом окне
          действие, которое относится к окну целиком, а не к открытому разделу.
      -->
      <Border Grid.Row="1" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <theme:Icon Grid.Column="0"
                      Glyph="lock.shield.fill"
                      Size="14"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{res:Loc AdminModeTitle}" />
            <!--
                Предупреждение, а не объяснение: перечислять, что лежит за
                дверью, менеджеру незачем — он туда не идёт; а вот знать, что
                дверь заперта, надо до нажатия, иначе запрос пароля выглядит
                отказом.
            -->
            <TextBlock Text="{res:Loc AdminModeNeedsPassword}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <!-- Шеврон — потому что кнопка ведёт в другое окно. Оно и заменяет
               собой это: «Управление» закрывает настройки, а не встаёт рядом. -->
          <Button Grid.Column="2"
                  Style="{StaticResource SettingsButtonStyle}"
                  Content="{res:Loc AdminModeOpen}"
                  Click="OnAdministrationClick" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
