<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:EliteSIP.App.Theme">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Panel/Graphite.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Setter Property="Margin" Value="0,8" /><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0" /></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Background" Value="{DynamicResource PanelCallBrush}" /><Setter Property="MinHeight" Value="32" /></Style>
  <Style x:Key="SettingsSliderPageStyle" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="3" CornerRadius="1.5" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
    <Setter Property="MinHeight" Value="26" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SettingsSliderPageStyle}" Background="{DynamicResource TextSecondaryBrush}" /></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="10" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource TextSecondaryBrush}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SettingsSliderPageStyle}" Background="{DynamicResource ControlPressedBrush}" /></Track.IncreaseRepeatButton>
      </Track></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Только пользовательские настройки: оформление «Управления» не меняется. -->
  <Style TargetType="theme:SettingsSection">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsSection">
      <Border Background="{DynamicResource PanelControlBrush}" CornerRadius="10" Padding="12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelEdgeBrush}" Effect="{StaticResource PanelShadow}">
        <StackPanel><TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" /><ItemsPresenter /></StackPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="theme:SettingsRow">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsRow">
      <Grid MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LabelColumn" Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ContentPresenter x:Name="RowLabel" Content="{TemplateBinding Header}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="Header" Value=""><Setter TargetName="LabelColumn" Property="Width" Value="0" /><Setter TargetName="RowLabel" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="theme:SettingsIndented"><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsIndented"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="theme:SettingsNote">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsNote"><TextBlock x:Name="Note" Text="{TemplateBinding Text}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><ControlTemplate.Triggers><Trigger Property="IsAlarming" Value="True"><Setter TargetName="Note" Property="Foreground" Value="{DynamicResource StatusFailureBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelSurfaceButtonStyle}"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="10,0" /><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style x:Key="SettingsSegmentStyle" TargetType="RadioButton">
    <Setter Property="Margin" Value="0,0,4,0" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Padding="10,7" CornerRadius="8" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelSelectedBrush}" /><Setter TargetName="Surface" Property="Effect" Value="{StaticResource PanelShadow}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSwitchStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
        <Border x:Name="Track" Grid.Column="1" Background="{DynamicResource ControlPressedBrush}" Width="34" Height="20" CornerRadius="10" VerticalAlignment="Center">
          <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" />
        </Border>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AnswerFillBrush}" /><Setter TargetName="Knob" Property="Fill" Value="White" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,4" /><Setter Property="Padding" Value="10,9" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter /></Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelControlBrush}" /><Setter TargetName="Surface" Property="Effect" Value="{StaticResource PanelShadow}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsThemeTileStyle" TargetType="RadioButton">
    <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Outline" CornerRadius="10" Padding="4" BorderThickness="1" BorderBrush="Transparent">
        <StackPanel><Border x:Name="MiniWindow" Width="110" Height="76" Background="#F1F1F1" CornerRadius="7" Padding="8">
          <Grid><Grid.RowDefinitions><RowDefinition Height="8" /><RowDefinition Height="6" /><RowDefinition Height="*" /><RowDefinition Height="6" /><RowDefinition Height="12" /></Grid.RowDefinitions>
            <Border Background="#888888" Width="34" HorizontalAlignment="Left" CornerRadius="4" />
            <Border x:Name="MiniCall" Grid.Row="2" Background="White" CornerRadius="5" />
            <Border Grid.Row="4" Background="{DynamicResource PanelAnswerBrush}" CornerRadius="4" />
          </Grid>
        </Border><ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="Dark"><Setter TargetName="MiniWindow" Property="Background" Value="#191919" /><Setter TargetName="MiniCall" Property="Background" Value="#383838" /></Trigger>
        <Trigger Property="Tag" Value="System"><Setter TargetName="MiniWindow" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F1F1F1" Offset="0.5" /><GradientStop Color="#191919" Offset="0.5" /></LinearGradientBrush></Setter.Value></Setter><Setter TargetName="MiniCall" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0.5" /><GradientStop Color="#383838" Offset="0.5" /></LinearGradientBrush></Setter.Value></Setter></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
