<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:history="clr-namespace:EliteSIP.App.History">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Panel/Graphite.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="HistoryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelSurfaceButtonStyle}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="HistoryBadgeStyle" TargetType="history:OutcomeBadge" BasedOn="{StaticResource {x:Type history:OutcomeBadge}}">
    <Style.Triggers>
      <Trigger Property="IsIncoming" Value="False"><Setter Property="Foreground" Value="{DynamicResource HistoryOutgoingBrush}" /></Trigger>
      <Trigger Property="IsIncoming" Value="True"><Setter Property="Foreground" Value="{DynamicResource OutcomeAnsweredBrush}" /></Trigger>
      <Trigger Property="Outcome" Value="Missed"><Setter Property="Foreground" Value="{DynamicResource HistoryMissedBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="HistoryFilterStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Grid x:Name="FilterLayout" Height="40" Margin="2,0">
          <Border x:Name="Surface" CornerRadius="10" Background="Transparent" />
          <Border x:Name="HoverLight" Margin="0" CornerRadius="10" Background="Transparent" IsHitTestVisible="False" />
          <ContentPresenter x:Name="Label" Margin="9,0" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Filter}" Value="All">
            <Setter TargetName="Label" Property="Margin" Value="12,0" />
            <Setter TargetName="FilterLayout" Property="MinWidth" Value="40" />
          </DataTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
            <Setter TargetName="HoverLight" Property="Background" Value="{DynamicResource HistoryFilterHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </MultiTrigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelControlBrush}" />
            <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource PanelShadow}" />
            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter TargetName="Surface" Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="HistoryScrollThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <!--
              Прозрачная подложка во всю ширину полосы, а сам ползунок внутри
              неё: тянуть надо за всю ширину, а видеть — только пилюлю.
          -->
          <Border Background="Transparent" Padding="2,8">
            <Border x:Name="Pill"
                    CornerRadius="3"
                    Background="{DynamicResource ScrollThumbBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <history:HistoryThumbViewportConverter x:Key="HistoryThumbViewport" />
  <Style x:Key="HistoryScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Margin" Value="0,12,0,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <!--
              Подложка появляется под курсором и в покое прозрачна: полоса
              лежит поверх содержимого, и постоянный жёлоб рисовал бы серую
              черту вдоль каждого списка.
          -->
          <Border x:Name="Track"
                  Background="Transparent"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.ViewportSize><MultiBinding Converter="{StaticResource HistoryThumbViewport}"><Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></Track.ViewportSize>
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource HistoryScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <!--
          Лежачая полоса — тот же шаблон, повёрнутый на бок. Отдельным
          шаблоном она разошлась бы с вертикальной при первой же правке, а
          нужна она в приложении один раз — под широкой таблицей истории.
      -->
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Border x:Name="Track"
                      Background="Transparent"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}">
                      <Thumb.LayoutTransform>
                        <RotateTransform Angle="90" />
                      </Thumb.LayoutTransform>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="HistoryCalendarDayStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Day" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.25" /><Setter Property="FontWeight" Value="Normal" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
