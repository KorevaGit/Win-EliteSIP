<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:history="clr-namespace:EliteSIP.App.History">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Panel/Graphite.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="HistoryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelSurfaceButtonStyle}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="HistoryBadgeStyle" TargetType="history:OutcomeBadge" BasedOn="{StaticResource {x:Type history:OutcomeBadge}}">
    <Style.Triggers>
      <Trigger Property="IsIncoming" Value="False"><Setter Property="Foreground" Value="{DynamicResource OutcomeUnreachableBrush}" /></Trigger>
      <Trigger Property="IsIncoming" Value="True"><Setter Property="Foreground" Value="{DynamicResource OutcomeAnsweredBrush}" /></Trigger>
      <Trigger Property="Outcome" Value="Missed"><Setter Property="Foreground" Value="{DynamicResource OutcomeMissedBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="HistoryFilterStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Grid Height="40" Margin="2,0">
          <Border x:Name="Surface" CornerRadius="8" Background="Transparent" />
          <Border x:Name="HoverLight" Margin="2" CornerRadius="6" Background="Transparent" IsHitTestVisible="False" />
          <ContentPresenter Margin="9,0" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
            <Setter TargetName="HoverLight" Property="Background" Value="{DynamicResource HistoryFilterHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </MultiTrigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelControlBrush}" />
            <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource PanelShadow}" />
            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter TargetName="Surface" Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
