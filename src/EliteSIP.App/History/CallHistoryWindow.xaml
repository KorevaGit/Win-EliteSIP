<Window x:Class="EliteSIP.App.History.CallHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:EliteSIP.App.Theme"
        xmlns:history="clr-namespace:EliteSIP.App.History"
        xmlns:res="clr-namespace:EliteSIP.App.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=history:CallHistoryViewModel}"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource PanelWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">

  <!--
      Отдельным окном, а не вкладкой панели: панель шириной 270 точек — это
      согласованное свойство продукта, а не текущее состояние вёрстки, и список
      с фильтрами и длительностями влезает туда только ценой нечитаемых строк.

      Уже 600 окно быть не может: ширину задаёт не строка, а верхний ряд —
      четыре кнопки фильтров со значками и снимок. Строка звонка укладывалась и
      в 520, а ряд нет: подпись «Пропущенные» ужималась до «Пропущенн…».

      Ниже 380 список перестаёт быть списком: видно две строки, и окно отвечает
      на «кому я звонил» одним звонком.
  -->

  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GraphiteHistory.xaml" /></ResourceDictionary.MergedDictionaries><SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource HistoryScrollThumbColor}" /><SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource HistoryScrollHoverColor}" /><SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent" /></ResourceDictionary></Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Height="32" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
              <Image Source="/EliteSIP.App;component/Assets/AppIcon/EliteSIP.ico" Width="14" Height="14" />
              <TextBlock Text="{TemplateBinding Title}" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="{res:Loc WindowMinimize}" AutomationProperties.Name="{res:Loc WindowMinimize}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10" /></Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMaximizeClick" ToolTip="{res:Loc WindowMaximize}" AutomationProperties.Name="{res:Loc WindowMaximize}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Tag="Close" Click="OnCaptionCloseClick" ToolTip="{res:Loc WindowClose}" AutomationProperties.Name="{res:Loc WindowClose}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10" /></Button>
            </StackPanel>
          </Grid>
          <AdornerDecorator><ContentPresenter /></AdornerDecorator>
        </DockPanel>
      </Border>
    </ControlTemplate>
  </Window.Template>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Фильтры слева, календарь и снимок справа. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" HorizontalAlignment="Left" Background="{DynamicResource HistoryFilterBackgroundBrush}" CornerRadius="10" Padding="2">
      <ItemsControl ItemsSource="{Binding Filters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type history:HistoryFilterItem}">
            <RadioButton Style="{StaticResource HistoryFilterStyle}"
                         GroupName="HistoryFilter"
                         Tag="{Binding Filter}"
                         Checked="OnFilterChosen">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                  <Binding Path="Filter" />
                  <Binding Path="DataContext.Filter" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                </MultiBinding>
              </RadioButton.IsChecked>
              <StackPanel Orientation="Horizontal">
                <!--
                    Значок тот же, что в строке списка, а не голая стрелка:
                    кнопка обязана показывать ровно ту фигуру, которую человек
                    будет искать глазами в списке.
                -->
                <history:OutcomeBadge Style="{StaticResource HistoryBadgeStyle}" Size="16"
                                      VerticalAlignment="Center"
                                      IsIncoming="{Binding IsIncoming}"
                                      IsCompleted="{Binding IsCompleted}"
                                      Outcome="{Binding Outcome}" />
                <TextBlock Text="{Binding Title}" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl></Border>

      <!--
          Кнопка дня и календарь под ней. Стоят в том же ряду, что фильтры:
          день — такой же отбор, как направление звонка, и разводить их по
          разным местам окна значило бы делить один вопрос надвое.
      -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0">
        <Button x:Name="CalendarButton"
                AutomationProperties.AutomationId="CalendarButton"
                AutomationProperties.Name="{res:Loc HistoryPickDay}"
                ToolTip="{res:Loc HistoryPickDay}"
                Click="OnCalendarClick" MinWidth="100">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource HistoryToolbarButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Calendar.HasSelectedDay}" Value="True">
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <theme:Icon Glyph="calendar" Size="16" VerticalAlignment="Center" />
            <!-- Дата не ужимается: «04.08.20…» — это дата, по которой нельзя
                 сказать, какой год выбран. -->
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{res:Loc HistoryAllDaysLabel}" /><Style.Triggers><DataTrigger Binding="{Binding Calendar.HasSelectedDay}" Value="True"><Setter Property="Text" Value="{Binding Calendar.SelectedDayTitle}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
        </Button>

        <!-- Крестик снимает отбор, не открывая того, что его поставило. -->
        <Button Style="{StaticResource PanelIconButtonStyle}"
                Margin="2,0,0,0"
                ToolTip="{res:Loc HistoryAllDays}"
                Click="OnClearDayClick"
                Visibility="{Binding Calendar.HasSelectedDay, Converter={StaticResource BoolToVisibility}}">
          <theme:Icon Glyph="xmark.circle.fill" Size="12" />
        </Button>
      </StackPanel>

      <Popup x:Name="CalendarPopup"
             PlacementTarget="{Binding ElementName=CalendarButton}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True" HorizontalOffset="-8" VerticalOffset="4"
             Opened="OnCalendarOpened">
        <Border Margin="8" Background="{DynamicResource PanelControlBrush}" Effect="{StaticResource PanelShadow}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                DataContext="{Binding Calendar}">
          <StackPanel>
            <Grid>
              <Button Style="{StaticResource PanelIconButtonStyle}"
                      HorizontalAlignment="Left"
                      Content="‹"
                      FontSize="17"
                      IsEnabled="{Binding CanShowPreviousMonth}"
                      Click="OnPreviousMonthClick" />

              <TextBlock Text="{Binding MonthTitle}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold" />

              <Button Style="{StaticResource PanelIconButtonStyle}"
                      HorizontalAlignment="Right"
                      Content="›"
                      FontSize="17"
                      IsEnabled="{Binding CanShowNextMonth}"
                      Click="OnNextMonthClick" />
            </Grid>

            <ItemsControl ItemsSource="{Binding WeekdayTitles}" Margin="0,6,0,2">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             Width="28"
                             FontSize="12"
                             TextAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Weeks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type history:CalendarWeek}">
                  <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type history:CalendarDay}">
                        <Button Width="28"
                                Height="28"
                                IsEnabled="{Binding IsAvailable}"
                                Click="OnDayClick">
                          <StackPanel>
                            <TextBlock Text="{Binding Number}"
                                       FontSize="13"
                                       TextAlignment="Center" />
                            <!-- Точка под числом: «в этот день были звонки». -->
                            <Ellipse Width="4"
                                     Height="4"
                                     Margin="0,1,0,0"
                                     HorizontalAlignment="Center"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     Visibility="{Binding HasCalls, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelSurfaceButtonStyle}">
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="Background" Value="Transparent" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource PanelSelectedBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!--
          Тот же «чип», что у кнопки дня рядом, — стиль, поля и кегль значка.
          Прежде снимок был кнопкой настроек со своей рамкой и полями и
          выходил меньше соседа, стоя с ним в одном ряду.
      -->
      <Button Grid.Column="2" HorizontalAlignment="Right"
              Style="{StaticResource HistoryToolbarButtonStyle}" Width="40"
              Click="OnSnapshotClick"
              IsEnabled="{Binding HasRecords}"
              ToolTip="{res:Loc HistorySnapshot}">
        <theme:Icon Glyph="camera" Size="16" VerticalAlignment="Center" />
      </Button>
    </Grid>

    <!--
        Список или пустое состояние — на одной и той же плашке. Слой один на оба
        случая намеренно: появляйся плашка только под строками, переключение
        фильтра на пустой набор меняло бы не содержимое окна, а его форму, — и
        это читается как поломка, а не как «здесь ничего нет».
    -->
    <Border Grid.Row="2"
            x:Name="ListSurface"
            Background="{DynamicResource PanelCallBrush}"
            Effect="{StaticResource PanelShadow}"
            CornerRadius="12">
      <Grid>
        <TextBlock Text="{res:Loc HistoryEmpty}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,8,6,8"
                      Padding="0"
                      ScrollChanged="OnScrollChanged"
                      Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type history:HistoryDay}">
                <StackPanel>
                  <!--
                      Заголовок дня — кеглем раздела, а не мелкой серой
                      подписью: день это то, по чему в списке ориентируются, и
                      вторым планом ему стоять нельзя.
                  -->
                  <TextBlock Text="{Binding Title}" Margin="14,18,14,6" FontSize="17" FontWeight="SemiBold" Visibility="{Binding IsToday, Converter={StaticResource NotBoolToVisibility}}" />

                  <!-- Тонкие линии разделяют записи; даты старых дней выделены отдельно. -->
                  <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="14,0" Padding="0,13" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                          <Grid MinHeight="48">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <history:OutcomeBadge Grid.Column="0" Style="{StaticResource HistoryBadgeStyle}" Size="40" VerticalAlignment="Center" Outcome="{Binding Outcome}" IsCompleted="{Binding IsAnswered}" IsIncoming="{Binding Converter={StaticResource IsIncoming}}" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                              <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><theme:Emoji.Text><MultiBinding Converter="{StaticResource CallTitle}"><Binding /><Binding Path="DataContext.OwnNumber" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.MasksMobileNumbers" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></theme:Emoji.Text></TextBlock>
                              <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"><theme:Emoji.Text><MultiBinding Converter="{StaticResource CallSubtitle}"><Binding /><Binding Path="DataContext.OwnNumber" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="DataContext.MasksMobileNumbers" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></theme:Emoji.Text></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                              <TextBlock Text="{Binding StartedAt, Converter={StaticResource CallStamp}, ConverterParameter=time}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                              <TextBlock Text="{Binding StartedAt, Converter={StaticResource CallStamp}, ConverterParameter=date}" FontSize="14" Margin="0,4,0,0" TextAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Converter={StaticResource OutcomeText}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right">
                              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsMissed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OutcomeMissedBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!--
            Сообщение о снимке — поверх списка и снизу, где его не закроет рука
            с мышью, идущая к кнопке наверху. В сам снимок оно не попадает:
            картинка собирается в момент нажатия, до того как сообщение
            появилось.
        -->
        <Border x:Name="Notice"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                Padding="12,6"
                CornerRadius="14"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}">
          <TextBlock x:Name="NoticeText" FontSize="12" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
