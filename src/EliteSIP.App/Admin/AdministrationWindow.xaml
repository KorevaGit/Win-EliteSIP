<Window x:Class="EliteSIP.App.Admin.AdministrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:EliteSIP.App.Theme" xmlns:admin="clr-namespace:EliteSIP.App.Admin" xmlns:settings="clr-namespace:EliteSIP.App.Settings" xmlns:res="clr-namespace:EliteSIP.App.Resources" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=admin:AdministrationViewModel}" Title="{res:Loc AdminWindowTitle}" Width="840" Height="540" MinWidth="740" MinHeight="440" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontSize="13" Background="{DynamicResource PanelWindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" TextOptions.TextFormattingMode="Display" theme:SettingsLayout.LabelColumn="132" theme:SettingsLayout.RowMaxWidth="560">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GraphiteAdministration.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Height="32" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
              <theme:CaptionCrown FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{TemplateBinding Title}" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="{res:Loc WindowMinimize}" AutomationProperties.Name="{res:Loc WindowMinimize}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" />
              </Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Click="OnMaximizeClick" ToolTip="{res:Loc WindowMaximize}" AutomationProperties.Name="{res:Loc WindowMaximize}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                          <Setter Property="Text" Value="" />
                        </DataTrigger>
                      </Style.Triggers>
                      <Setter Property="Text" Value="" />
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Button>
              <Button Style="{StaticResource PanelCaptionButtonStyle}" Tag="Close" Click="OnCaptionCloseClick" ToolTip="{res:Loc WindowClose}" AutomationProperties.Name="{res:Loc WindowClose}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" />
              </Button>
            </StackPanel>
          </Grid>
          <AdornerDecorator>
            <ContentPresenter />
          </AdornerDecorator>
        </DockPanel>
      </Border>
    </ControlTemplate>
  </Window.Template>
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,10,0,7">
        <theme:Icon Glyph="settings.shield-check" Size="15" />
        <TextBlock Text="{res:Loc AdminAccessOpenSession}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Sections}" SelectedValue="{Binding Section}" SelectedValuePath="Kind" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource SettingsNavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <theme:Icon Glyph="{Binding Glyph}" Size="18" />
              <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="AdminScroller" Style="{StaticResource SettingsContentScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,0,0">
        <StackPanel x:Name="AdminPages" Margin="0,0,0,4">
          <Grid Height="43">
            <TextBlock Text="{Binding SectionTitle}" FontSize="21" FontWeight="SemiBold" Margin="5,0,0,7" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Visibility="{Binding ShowsAccount, Converter={StaticResource BoolToVisibility}}">
            <theme:SettingsSection Header="" Tag="settings.users-round">
              <Grid Margin="0,8,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <theme:Icon Glyph="settings.users-round" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{res:Loc AdminProfiles}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SettingsButtonStyle}" Height="28" FontSize="12" Click="OnAccountAddClick" ToolTip="{res:Loc AdminProfileSwitchHint}">
                  <StackPanel Orientation="Horizontal"><theme:Icon Glyph="settings.users-round" Size="14" /><TextBlock Text="{res:Loc AdminProfileAdd}" Margin="6,0,0,0" /></StackPanel>
                </Button>
              </Grid>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="146" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{res:Loc AdminAccountUsername}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{res:Loc AdminProfileLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="{res:Loc AdminAccountPassword}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
              <ItemsControl x:Name="AccountItems" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type admin:AdminAccountDraft}">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="146" />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>
                      <TextBox Tag="AccountNumber" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminAccountUsername}" />
                      <TextBox Grid.Column="2" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminProfileLabel}" />
                      <TextBox Grid.Column="4" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminAccountPassword}" />
                      <theme:Icon Grid.Column="5" Glyph="settings.check" Size="15" Foreground="{DynamicResource SettingsGreenBrush}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" ToolTip="{res:Loc AdminActiveProfile}" />
                      <Button Grid.Column="5" Style="{StaticResource AdminSmallButtonStyle}" Margin="6,0,0,0" Click="OnAccountRemoveClick" Visibility="{Binding IsActive, Converter={StaticResource NotBoolToVisibility}}" ToolTip="{res:Loc AdminProfileRemove}" AutomationProperties.Name="{res:Loc AdminProfileRemove}">
                        <theme:Icon Glyph="trash" Size="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminPbxTitle}" Tag="settings.server">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.router" Size="25" HorizontalAlignment="Center" />
                  <TextBlock Text="{res:Loc WorkPlace}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.server" Size="25" HorizontalAlignment="Center" />
                  <TextBlock Text="АТС" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <theme:SettingsRow Header="{res:Loc AdminPbxOffice}">
                <Border Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding OfficeAddress, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminPbxRemote}">
                <Border Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding RemoteAddress, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </theme:SettingsRow>
              <Expander Header="{res:Loc AdminConnectionAdvanced}">
                <StackPanel>
                  <theme:SettingsRow Header="{res:Loc AdminPbxPort}">
                    <Border Height="33" Width="90" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                      <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                  </theme:SettingsRow>
                  <theme:SettingsRow Header="{res:Loc AdminPbxTransport}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Transport" Content="UDP" IsChecked="{Binding Transport, Converter={StaticResource EnumToBool}, ConverterParameter=Udp}" />
                      <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Transport" Content="TCP" IsChecked="{Binding Transport, Converter={StaticResource EnumToBool}, ConverterParameter=Tcp}" />
                      <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Transport" Content="TLS" IsChecked="{Binding Transport, Converter={StaticResource EnumToBool}, ConverterParameter=Tls}" />
                    </StackPanel>
                  </theme:SettingsRow>
                  <theme:SettingsRow Header="{res:Loc AdminPbxExpiry}">
                    <Border Height="33" Width="90" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                      <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding RegistrationExpirySeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                  </theme:SettingsRow>
                  <theme:SettingsSection Header="{res:Loc AdminPbxTlsTitle}" Visibility="{Binding IsTls, Converter={StaticResource BoolToVisibility}}" Tag="settings.circle">
                    <theme:SettingsRow Header="{res:Loc AdminPbxTlsFingerprint}">
                      <Border Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                        <TextBox Style="{StaticResource PanelTextBoxStyle}" IsEnabled="{Binding AcceptsAnyTlsCertificate, Converter={StaticResource NotBool}}" Text="{Binding PinnedCertificateFingerprint, UpdateSourceTrigger=PropertyChanged}" />
                      </Border>
                    </theme:SettingsRow>
                    <theme:SettingsDivider />
                    <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding AcceptsAnyTlsCertificate}">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                        <TextBlock Text="{res:Loc AdminPbxTlsAcceptAny}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                  </theme:SettingsSection>
                </StackPanel>
              </Expander>
              <Expander Header="{res:Loc AdminKnockTitle}">
                <StackPanel>
                  <theme:SettingsSection Header="{res:Loc AdminKnockTitle}" Tag="settings.circle">
                    <ItemsControl ItemsSource="{Binding KnockSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:PortKnockStepSetting}">
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="6" />
                              <ColumnDefinition Width="70" />
                              <ColumnDefinition Width="6" />
                              <ColumnDefinition Width="50" />
                              <ColumnDefinition Width="6" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                              <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockHost}" />
                            </Border>
                            <Border Grid.Column="2" Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                              <TextBox Style="{StaticResource PanelTextBoxStyle}" FontFamily="Consolas" Text="{Binding PayloadBytes, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockBytes}" />
                            </Border>
                            <Border Grid.Column="4" Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                              <TextBox Style="{StaticResource PanelTextBoxStyle}" FontFamily="Consolas" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminKnockCount}" />
                            </Border>
                            <Button Grid.Column="6" Style="{StaticResource SettingsButtonStyle}" Padding="6,2" ToolTip="{res:Loc AdminMacroRemove}" Click="OnKnockRemoveClick">
                              <theme:Icon Glyph="trash" Size="12" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <theme:SettingsIndented>
                      <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminKnockAdd}" Click="OnKnockAddClick" />
                    </theme:SettingsIndented>
                    <theme:SettingsDivider />
                    <theme:SettingsRow Header="{res:Loc AdminKnockSpacing}">
                      <Border Height="33" Width="90" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                        <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding KnockSpacingSeconds, UpdateSourceTrigger=PropertyChanged}" />
                      </Border>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminKnockRepeat}">
                      <Border Height="33" Width="90" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                        <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding KnockRepeatIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                      </Border>
                    </theme:SettingsRow>
                    <theme:SettingsNote Text="{Binding KnockSummary}" />
                  </theme:SettingsSection>
                </StackPanel>
              </Expander>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel Visibility="{Binding ShowsMacros, Converter={StaticResource BoolToVisibility}}">
            <theme:SettingsSection Header="{res:Loc AdminMacrosTitle}" Tag="settings.panels-top-left">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="102" />
                  <ColumnDefinition Width="128" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{res:Loc AdminMacroTitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{res:Loc AdminMacroSequence}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{res:Loc AdminMacroTransferShort}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type settings:MacroSetting}">
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="86" />
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminMacroTitle}" />
                      <TextBox Grid.Column="2" Text="{Binding Sequence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Loc AdminMacroSequence}" />
                      <CheckBox Grid.Column="4" Style="{StaticResource AdminInlineSwitchStyle}" IsChecked="{Binding TransfersCall}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{res:Loc AdminMacroTransfers}" AutomationProperties.Name="{res:Loc AdminMacroTransfers}" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource AdminSmallButtonStyle}" Click="OnMacroUpClick" Content="↑" ToolTip="{res:Loc AdminMacroUp}" />
                        <Button Style="{StaticResource AdminSmallButtonStyle}" Margin="3,0" Click="OnMacroDownClick" Content="↓" ToolTip="{res:Loc AdminMacroDown}" />
                        <Button Style="{StaticResource AdminSmallButtonStyle}" Click="OnMacroRemoveClick" ToolTip="{res:Loc AdminMacroRemove}">
                          <theme:Icon Glyph="trash" Size="13" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <theme:SettingsIndented>
                <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminMacroAdd}" Click="OnMacroAddClick" />
              </theme:SettingsIndented>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <theme:Icon Glyph="settings.arrow-right" Size="14" VerticalAlignment="Center" />
                <TextBlock Text="{res:Loc AdminTransferEffect}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminMacroLayout}" Tag="settings.panels-top-left">
              <theme:SettingsRow Header="{res:Loc AdminMacroColumns}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Columns" Content="2" IsChecked="{Binding MacroColumns, Converter={StaticResource EnumToBool}, ConverterParameter=2}" />
                  <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Columns" Content="3" IsChecked="{Binding MacroColumns, Converter={StaticResource EnumToBool}, ConverterParameter=3}" />
                  <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="Columns" Content="4" IsChecked="{Binding MacroColumns, Converter={StaticResource EnumToBool}, ConverterParameter=4}" />
                </StackPanel>
              </theme:SettingsRow>
              <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding MacroHeightIsManual, Converter={StaticResource NotBool}}">
                <StackPanel Orientation="Horizontal">
                  <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                  <TextBlock Text="{res:Loc AdminMacroHeightAuto}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>
              <theme:SettingsRow Header="{res:Loc AdminMacroHeight}" IsEnabled="{Binding MacroHeightIsManual}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="44" Maximum="96" IsSnapToTickEnabled="True" TickFrequency="2" VerticalAlignment="Center" Value="{Binding MacroHeight}" />
                  <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding MacroHeight}" />
                </Grid>
              </theme:SettingsRow>
              <ItemsControl ItemsSource="{Binding Macros}" Margin="-3,4,-3,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding MacroColumns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="3" Padding="8" CornerRadius="8" Background="{DynamicResource SettingsLineBrush}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="MinHeight" Value="56" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.MacroHeightIsManual, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                              <Setter Property="MinHeight" Value="{Binding DataContext.MacroHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding Sequence}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </theme:SettingsSection>
            <theme:SettingsSection Header="{res:Loc AdminPbxFeatureTitle}" Tag="settings.headset">
              <theme:SettingsRow Header="{res:Loc AdminPbxTransfer}">
                <Border Height="33" Width="120" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" FontFamily="Consolas" Text="{Binding TransferFeatureCode, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminPbxConference}">
                <Border Height="33" Width="120" HorizontalAlignment="Left" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                  <TextBox Style="{StaticResource PanelTextBoxStyle}" FontFamily="Consolas" Text="{Binding ConferenceFeatureCode, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel Visibility="{Binding ShowsIncoming, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource AdminTabsStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="IncomingPage" Content="{res:Loc AdminQueuesTitle}" IsChecked="{Binding IncomingPage, Converter={StaticResource EnumToBool}, ConverterParameter=Queues}" />
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="IncomingPage" Content="{res:Loc AdminReceive}" IsChecked="{Binding IncomingPage, Converter={StaticResource EnumToBool}, ConverterParameter=Answer}" />
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="IncomingPage" Content="{res:Loc AdminGuardTitle}" IsChecked="{Binding IncomingPage, Converter={StaticResource EnumToBool}, ConverterParameter=Guard}" />
              </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding ShowsQueues, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminQueuesTitle}" Tag="settings.users-round">
                <ItemsControl ItemsSource="{Binding Queues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:QueueSetting}">
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                          <TextBox Style="{StaticResource PanelTextBoxStyle}" FontFamily="Consolas" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminQueueNumber}" />
                        </Border>
                        <Border Grid.Column="2" Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                          <TextBox Style="{StaticResource PanelTextBoxStyle}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Loc AdminQueueTitle}" />
                        </Border>
                        <Button Grid.Column="4" Style="{StaticResource SettingsButtonStyle}" Padding="6,2" ToolTip="{res:Loc AdminMacroRemove}" Click="OnQueueRemoveClick">
                          <theme:Icon Glyph="trash" Size="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <theme:SettingsIndented>
                  <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminQueueAdd}" Click="OnQueueAddClick" />
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsIncomingAnswer, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminAutoAnswerTitle}" Tag="settings.headset">
                <theme:SettingsRow Header="{res:Loc AdminAutoAnswerTitle}">
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Guard.AutoAnswer, Mode=TwoWay}">
                    <ComboBoxItem Tag="off" Content="{res:Loc AdminAnswerOperatorShort}" />
                    <ComboBoxItem Tag="header" Content="{res:Loc AdminAnswerHeaderShort}" />
                    <ComboBoxItem Tag="list" Content="{res:Loc AdminAnswerListShort}" />
                    <ComboBoxItem Tag="always" Content="{res:Loc AdminAnswerAlwaysShort}" />
                  </ComboBox>
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminAutoAnswerNumbers}" Margin="0,8,0,0" Visibility="{Binding Guard.AutoAnswerList, Converter={StaticResource BoolToVisibility}}">
                  <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="6,4" Background="{DynamicResource ControlBackgroundBrush}">
                    <TextBox Style="{StaticResource PanelTextBoxStyle}" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Guard.AutoAnswerNumbersText, UpdateSourceTrigger=LostFocus}" />
                  </Border>
                </theme:SettingsRow>
                <theme:SettingsNote Text="{res:Loc AdminAutoAnswerAlwaysNote}" IsAlarming="True" Visibility="{Binding Guard.AutoAnswerAlways, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminSectionIncoming}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.users-round" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AutoAnswerPreview}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminConversation}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </theme:SettingsSection>
              <theme:SettingsSection Header="{res:Loc AdminNumbersTitle}" Tag="settings.headset">
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.MasksMobileNumbers}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminMasksMobileNumbers}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding MobilePreview}" Margin="25,4,0,6" FontSize="15" FontWeight="SemiBold" />
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsIncomingGuard, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminGuardTitle}" Tag="settings.shield-check">
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.IsEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminGuardEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <theme:SettingsNote Text="{res:Loc AdminGuardOffShort}" IsAlarming="True" Visibility="{Binding Guard.IsGuardOff, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.IsRandomPositionEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminGuardRandomPosition}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardRandomTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="RandomTuning" Content="{res:Loc AdminGuardTuningAuto}" IsChecked="{Binding Guard.TunesRandomnessAutomatically}" />
                        <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="RandomTuning" Content="{res:Loc AdminGuardTuningManual}" IsChecked="{Binding Guard.TunesRandomnessByHand}" />
                      </StackPanel>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardMinimumTravel}" IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="600" IsSnapToTickEnabled="True" TickFrequency="25" VerticalAlignment="Center" Value="{Binding Guard.MinimumTravel}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.MinimumTravel, StringFormat={}{0:F0}}" />
                      </Grid>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardScreenMargin}" IsEnabled="{Binding Guard.RandomnessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="8" VerticalAlignment="Center" Value="{Binding Guard.ScreenMargin}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.ScreenMargin, StringFormat={}{0:F0}}" />
                      </Grid>
                    </theme:SettingsRow>
                  </StackPanel>
                </Expander>
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.AsksForDigit}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminGuardDigitEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardDigitTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTargets}" IsEnabled="{Binding Guard.AsksForDigit}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="2" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Value="{Binding Guard.TargetCount}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.TargetCount}" />
                      </Grid>
                    </theme:SettingsRow>
                  </StackPanel>
                </Expander>
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.RequiresCursorMovement}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminGuardCursor}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <Expander Header="{res:Loc AdminGuardLivenessTitle}">
                  <StackPanel>
                    <theme:SettingsRow Header="{res:Loc AdminGuardTuning}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="LivenessTuning" Content="{res:Loc AdminGuardTuningAuto}" IsChecked="{Binding Guard.TunesLivenessAutomatically}" />
                        <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="LivenessTuning" Content="{res:Loc AdminGuardTuningManual}" IsChecked="{Binding Guard.TunesLivenessByHand}" />
                      </StackPanel>
                    </theme:SettingsRow>
                    <theme:SettingsRow Header="{res:Loc AdminGuardCursorTravel}" IsEnabled="{Binding Guard.LivenessSlidersAreEditable}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" Value="{Binding Guard.RequiredCursorTravel}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Guard.RequiredCursorTravel, StringFormat={}{0:F0}}" />
                      </Grid>
                    </theme:SettingsRow>
                    <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Guard.RejectsSyntheticEvents}">
                      <StackPanel Orientation="Horizontal">
                        <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                        <TextBlock Text="{res:Loc AdminGuardSynthetic}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </Expander>
              </theme:SettingsSection>
            </StackPanel>
            <theme:SettingsSection Header="{res:Loc AdminGuardCheckTitle}" Tag="settings.activity">
              <Border Background="{DynamicResource SettingsFieldBrush}" CornerRadius="9" Padding="12" Margin="0,3,0,10">
                <Grid MinHeight="82">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <theme:Icon Grid.RowSpan="2" Glyph="settings.headset" Size="28" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding IncomingPreviewTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding MobilePreview}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{res:Loc AdminReceivePreview}" FontSize="11" Margin="0,0,0,7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding PreviewDigits}" Visibility="{Binding ShowsDigitExample, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border CornerRadius="7" Background="{DynamicResource SettingsLineBrush}" Padding="8" Margin="0,0,4,4">
                              <TextBlock Text="{Binding}" HorizontalAlignment="Center" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <UniformGrid Columns="2" Visibility="{Binding ShowsAnswerExample, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="7" Background="{DynamicResource AnswerFillBrush}" Padding="7" Margin="0,0,4,0">
                          <TextBlock Text="{res:Loc IncomingAnswer}" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="7" Background="{DynamicResource DeclineFillBrush}" Padding="7">
                          <TextBlock Text="{res:Loc IncomingDecline}" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                      </UniformGrid>
                      <StackPanel Visibility="{Binding ShowsAutomaticExample, Converter={StaticResource BoolToVisibility}}">
                        <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AutoAnswerPreview}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <theme:SettingsIndented>
                <WrapPanel>
                  <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminGuardCheckShow}" Command="{Binding PreviewDistribution}" />
                  <Button Style="{StaticResource SettingsButtonStyle}" Margin="6,0,0,0" Content="{res:Loc AdminGuardCheckDeal}" Command="{Binding PreviewDeal}" />
                </WrapPanel>
              </theme:SettingsIndented>
              <theme:SettingsRow Header="{res:Loc AdminGuardLastCall}" Visibility="{Binding LastGuardReport, Converter={StaticResource PresenceToVisibility}}">
                <TextBlock Text="{Binding LastGuardReport}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>
            </theme:SettingsSection>
          </StackPanel>
          <StackPanel Visibility="{Binding ShowsSystem, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource AdminTabsStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="SystemPage" Content="{res:Loc AdminData}" IsChecked="{Binding SystemPage, Converter={StaticResource EnumToBool}, ConverterParameter=Data}" />
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="SystemPage" Content="{res:Loc AdminAccessShort}" IsChecked="{Binding SystemPage, Converter={StaticResource EnumToBool}, ConverterParameter=Access}" />
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="SystemPage" Content="{res:Loc AdminUpdateShort}" IsChecked="{Binding SystemPage, Converter={StaticResource EnumToBool}, ConverterParameter=Updates}" />
                <RadioButton Style="{StaticResource SettingsSegmentStyle}" GroupName="SystemPage" Content="{res:Loc AdminResetTitle}" IsChecked="{Binding SystemPage, Converter={StaticResource EnumToBool}, ConverterParameter=Reset}" />
              </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding ShowsHistory, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminHistoryTitle}" Tag="settings.activity">
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding HistoryIsEnabled}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminHistoryEnabled}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <theme:SettingsRow Header="{res:Loc AdminHistoryAge}" IsEnabled="{Binding HistoryIsEnabled}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="1" Maximum="365" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Value="{Binding HistoryAgeInDays}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HistoryAgeInDays}" />
                  </Grid>
                </theme:SettingsRow>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.headset" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminCall}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.activity" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding HistoryAgeInDays, StringFormat={}{0} дн.}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.archive" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminRetentionEffect}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </theme:SettingsSection>
              <theme:SettingsSection Header="{res:Loc AdminMaintenanceTitle}" Tag="settings.file-text">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.file-text" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminLogShort}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.archive" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc SettingsSupportArchive}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding LogToFile}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminMaintenanceLog}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsEnabled="{Binding LogToFile}" IsChecked="{Binding LogsSipTrace}">
                  <StackPanel Orientation="Horizontal">
                    <theme:Icon Glyph="settings.sliders-horizontal" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminMaintenanceTrace}" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <theme:SettingsDivider />
                <theme:SettingsIndented>
                  <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminDiagnosticsOpenFolder}" Click="OnOpenFolderClick" />
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsAccess, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminAccessTitle}" Tag="settings.lock-keyhole">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc SettingsManagement}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.lock-keyhole" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AccessStatus}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
                <theme:SettingsRow Header="{res:Loc AdminAccessNewPassword}">
                  <Border Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                    <PasswordBox x:Name="NewPasswordField" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" PasswordChanged="OnNewPasswordChanged" />
                  </Border>
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminAccessRepeatPassword}">
                  <Border Height="33" CornerRadius="7" Padding="6,0" Background="{DynamicResource SettingsFieldBrush}">
                    <PasswordBox x:Name="RepeatedPasswordField" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" PasswordChanged="OnRepeatedPasswordChanged" />
                  </Border>
                </theme:SettingsRow>
                <theme:SettingsNote Text="{res:Loc AdminAccessMismatch}" IsAlarming="True" Visibility="{Binding PasswordsDiffer, Converter={StaticResource BoolToVisibility}}" />
                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminAccessSet}" IsEnabled="{Binding CanSetPassword}" Click="OnSetPasswordClick" />
                    <Button Style="{StaticResource SettingsButtonStyle}" Margin="6,0,0,0" Content="{res:Loc AdminAccessRemove}" IsEnabled="{Binding IsProtected}" Click="OnRemovePasswordClick" />
                  </StackPanel>
                </theme:SettingsIndented>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsDiagnostics, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminDiagnosticsTitle}" Tag="settings.package">
                <theme:SettingsRow Header="{res:Loc SupportVersion}">
                  <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </theme:SettingsRow>
                <theme:SettingsRow Header="{res:Loc AdminDiagnosticsSettingsPath}">
                  <TextBlock Text="{Binding SettingsPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </theme:SettingsRow>
                <theme:SettingsIndented>
                  <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminDiagnosticsOpenFolder}" Click="OnOpenFolderClick" />
                </theme:SettingsIndented>
                <StackPanel DataContext="{Binding Updates}" Visibility="{Binding Converter={StaticResource PresenceToVisibility}}">
                  <theme:SettingsDivider />
                  <theme:SettingsIndented>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminDiagnosticsCheckUpdates}" Command="{Binding CheckNow}" />
                      <Button Style="{StaticResource SettingsButtonStyle}" Margin="6,0,0,0" Content="{res:Loc AdminDiagnosticsInstallUpdate}" Command="{Binding Install}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </theme:SettingsIndented>
                  <theme:SettingsNote Text="{Binding Status}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </theme:SettingsSection>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsReset, Converter={StaticResource BoolToVisibility}}">
              <theme:SettingsSection Header="{res:Loc AdminResetTitle}" Tag="settings.refresh-cw">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.file-text" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminResetData}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                  <StackPanel MinWidth="62" Margin="12,0">
                    <theme:Icon Glyph="settings.unplug" Size="25" HorizontalAlignment="Center" />
                    <TextBlock Text="{res:Loc AdminResetGone}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
                <theme:SettingsIndented>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminResetButton}" IsEnabled="{Binding CanResetMachine}" Click="OnResetMachineClick" />
                    <TextBlock Text="{res:Loc AdminResetInCall}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanResetMachine}" Value="False">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </theme:SettingsIndented>
                <theme:SettingsNote Text="{res:Loc AdminResetIrreversible}" IsAlarming="True" />
              </theme:SettingsSection>
            </StackPanel>
          </StackPanel>
          <StackPanel DataContext="{Binding Support}" Visibility="{Binding DataContext.ShowsSupport, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <theme:SettingsSection Header="{res:Loc AdminSupportTitle}" Tag="settings.cloud">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.monitor" Size="25" HorizontalAlignment="Center" />
                  <TextBlock Text="{res:Loc SettingsThisPc}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <theme:Icon Glyph="settings.arrow-right" Size="16" VerticalAlignment="Center" />
                <StackPanel MinWidth="62" Margin="12,0">
                  <theme:Icon Glyph="settings.cloud" Size="25" HorizontalAlignment="Center" />
                  <TextBlock Text="Spark" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <theme:SettingsRow Header="{res:Loc AdminSupportMachine}">
                <TextBlock Text="{Binding InstallationID}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportPreset}">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{Binding PresetName, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{res:Loc AdminSupportRevision}" />
                  <Run Text=" " />
                  <Run Text="{Binding AppliedRevision, Mode=OneWay}" />
                </TextBlock>
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportLastContact}">
                <TextBlock Text="{Binding LastContact}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>
              <theme:SettingsRow Header="{res:Loc AdminSupportLink}">
                <TextBlock Text="{Binding LinkState}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
              </theme:SettingsRow>
              <theme:SettingsDivider />
              <theme:SettingsIndented>
                <Grid>
                  <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc AdminSupportCheckNow}" Command="{Binding CheckNow}" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                  <Button Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left" Content="{res:Loc SupportReturnOnline}" Command="{Binding ReturnOnline}" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </theme:SettingsIndented>
              <theme:SettingsNote Text="{res:Loc SupportReturnOnlineNote}" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
              <theme:SettingsNote Text="{Binding Report}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
            </theme:SettingsSection>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" Margin="26,8,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SaveStateTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding SaveStateBody}" />
          <TextBlock Text="{Binding AccountError}" FontSize="11" Foreground="{DynamicResource StatusFailureBrush}" Visibility="{Binding HasAccountError, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminRevert}" Click="OnRevertClick" IsEnabled="{Binding IsDirty}" />
          <Button Style="{StaticResource SettingsButtonStyle}" Content="{res:Loc AdminSave}" Click="OnSaveClick" IsEnabled="{Binding CanSave}" Margin="8,0,0,0" Foreground="{DynamicResource SettingsGreenBrush}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
