<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:EliteSIP.App.Theme">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Settings/SettingsDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
 <Style TargetType="TextBox" BasedOn="{StaticResource PanelTextBoxStyle}"><Setter Property="MinHeight" Value="33" /><Setter Property="Padding" Value="7,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{DynamicResource SettingsFieldBrush}" CornerRadius="7" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" /></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="theme:SettingsSection">
  <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsSection"><Border x:Name="Surface" Background="{DynamicResource SettingsSurfaceBrush}" CornerRadius="11" Padding="13,0,13,9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SettingsEdgeBrush}" Effect="{StaticResource SettingsSurfaceShadow}"><StackPanel><StackPanel x:Name="Heading" Orientation="Horizontal" Margin="0,11,0,8"><theme:Icon Glyph="{TemplateBinding Tag}" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{TemplateBinding Header}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /></StackPanel><ItemsPresenter /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="Header" Value=""><Setter TargetName="Heading" Property="Visibility" Value="Collapsed" /></Trigger><Trigger Property="Tag" Value="settings.circle"><Setter TargetName="Surface" Property="Background" Value="Transparent" /><Setter TargetName="Surface" Property="Effect" Value="{x:Null}" /><Setter TargetName="Surface" Property="Padding" Value="0" /><Setter TargetName="Surface" Property="BorderThickness" Value="0" /><Setter TargetName="Heading" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="theme:SettingsRow"><Setter Property="Margin" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="theme:SettingsRow"><Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LabelColumn" Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ContentPresenter x:Name="Label" Content="{TemplateBinding Header}" VerticalAlignment="Center" Margin="0,0,10,0" /><ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" /></Grid><ControlTemplate.Triggers><Trigger Property="Header" Value=""><Setter TargetName="LabelColumn" Property="Width" Value="0" /><Setter TargetName="Label" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="SettingsSwitchStyle" TargetType="CheckBox"><Setter Property="Margin" Value="0" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid MinHeight="40" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="33" /></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" /><Border Grid.Column="1" x:Name="Track" Background="{DynamicResource SettingsTrackBrush}" Width="33" Height="19" CornerRadius="10" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="13" Height="13" Fill="{DynamicResource SettingsKnobBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" /></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsSwitchBrush}" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="AdminInlineSwitchStyle" TargetType="CheckBox"><Setter Property="Width" Value="33" /><Setter Property="Height" Value="19" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Background="{DynamicResource SettingsTrackBrush}" CornerRadius="10"><Ellipse x:Name="Knob" Width="13" Height="13" Fill="{DynamicResource SettingsKnobBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsSwitchBrush}" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="AdminSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="3" /></Style>
 <Style x:Key="AdminTabsStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SettingsLineBrush}" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
 <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" MinHeight="31"><DockPanel><theme:Icon Glyph="chevron.down" Size="10" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" /><ContentPresenter VerticalAlignment="Center" /></DockPanel></Border></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" /></ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,4,0,4" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
