<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Проверка манифеста берётся у клиента, а не пишется здесь заново, и это
      главное решение этого инструмента: релизный скрипт после подписи читает
      манифест ровно тем кодом, которым его прочитает рабочее место. Своя копия
      проверки означала бы, что скрипт согласен сам с собой.
    -->
    <ProjectReference Include="..\..\src\EliteSIP.PanelLink\EliteSIP.PanelLink.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>releasekit</AssemblyName>
  </PropertyGroup>

</Project>
