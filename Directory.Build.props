      Р В·Р Р†Р С•Р Р…Р С”Р С•Р Р† РЎР‚Р В°Р Р…РЎРЉРЎв‚¬Р Вµ, РЎвЂЎР ВµР С Р С”РЎвЂљР С•-Р Р…Р С‘Р В±РЎС“Р Т‘РЎРЉ Р В·Р В°Р СР ВµРЎвЂљР С‘Р В» Р В±РЎвЂ№.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
