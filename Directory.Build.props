<Project>

  <!--
    РћР±С‰РёРµ СЃРІРѕР№СЃС‚РІР° РІСЃРµС… РїСЂРѕРµРєС‚РѕРІ СЂРµС€РµРЅРёСЏ. РћРґРёРЅ С„Р°Р№Р», С‡С‚РѕР±С‹ РЅР°СЃС‚СЂРѕР№РєРё РЅРµ
    СЂР°СЃС…РѕРґРёР»РёСЃСЊ РјРµР¶РґСѓ РґРµСЃСЏС‚РєРѕРј .csproj: РІ РѕСЂРёРіРёРЅР°Р»Рµ С‚Сѓ Р¶Рµ СЂРѕР»СЊ РёРіСЂР°Р»
    Version.xcconfig Рё РѕР±С‰РёРµ swiftSettings РІ РєР°Р¶РґРѕРј Package.swift.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Nullable Рё РїСЂРµРґСѓРїСЂРµР¶РґРµРЅРёСЏ-РєР°Рє-РѕС€РёР±РєРё вЂ” СЌС‚Рѕ С‚Рѕ РЅРµРјРЅРѕРіРѕРµ, С‡РµРј РІ C#
      РІРѕСЃРїСЂРѕРёР·РІРѕРґРёС‚СЃСЏ СЃС‚СЂРѕРіРѕСЃС‚СЊ Swift 6. РћСЂРёРіРёРЅР°Р» СЃРѕР±РёСЂР°Р»СЃСЏ РІ
      .swiftLanguageMode(.v6), РіРґРµ РЅРё nil, РЅРё РіРѕРЅРєСѓ С‡РµСЂРµР· РіСЂР°РЅРёС†Сѓ РїРѕС‚РѕРєР°
      РїСЂРѕС‚Р°С‰РёС‚СЊ Р±С‹Р»Рѕ РЅРµР»СЊР·СЏ. РћС‚РєР»СЋС‡Р°С‚СЊ РїРѕ РїСЂРѕРµРєС‚Сѓ РЅРµР»СЊР·СЏ: СЃРјС‹СЃР» РёРјРµРЅРЅРѕ РІ С‚РѕРј,
      С‡С‚Рѕ РїСЂР°РІРёР»Рѕ РѕРґРЅРѕ РЅР° РІСЃС‘ СЂРµС€РµРЅРёРµ.
    -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      РРЅС‚РµСЂС„РµР№СЃ РґРІСѓСЏР·С‹С‡РЅС‹Р№ (ru/en), РїРѕСЌС‚РѕРјСѓ РіР»РѕР±Р°Р»РёР·Р°С†РёСЋ РЅРµ СѓСЂРµР·Р°РµРј.
      РРЅРІР°СЂРёР°РЅС‚РЅС‹Р№ СЂРµР¶РёРј СЃР»РѕРјР°Р» Р±С‹ СЃСЂР°РІРЅРµРЅРёРµ Рё СЃРѕСЂС‚РёСЂРѕРІРєСѓ СЃС‚СЂРѕРє РІ РёСЃС‚РѕСЂРёРё
      Р·РІРѕРЅРєРѕРІ СЂР°РЅСЊС€Рµ, С‡РµРј РєС‚Рѕ-РЅРёР±СѓРґСЊ Р·Р°РјРµС‚РёР» Р±С‹.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      РЇР·С‹РєРё СЂРµСЃСѓСЂСЃРѕРІ: С‚РѕР»СЊРєРѕ С‚Рµ, РЅР° РєРѕС‚РѕСЂС‹С… РїСЂРёР»РѕР¶РµРЅРёРµ РіРѕРІРѕСЂРёС‚.

      WPF С‚Р°С‰РёС‚ РІ СЃР°РјРѕРґРѕСЃС‚Р°С‚РѕС‡РЅСѓСЋ РїСѓР±Р»РёРєР°С†РёСЋ СЃРІРѕРё РїРµСЂРµРІРѕРґС‹ РЅР° С‡РµС‚С‹СЂРЅР°РґС†Р°С‚СЊ
      СЏР·С‹РєРѕРІ вЂ” РІРѕСЃРµРјРЅР°РґС†Р°С‚СЊ РјРµРіР°Р±Р°Р№С‚, РёР· РєРѕС‚РѕСЂС‹С… РЅСѓР¶РЅС‹ РґРІР°. РЎ РїРµСЂРµС…РѕРґРѕРј РЅР°
      СЃР°РјРѕРґРѕСЃС‚Р°С‚РѕС‡РЅС‹Р№ РІС‹РїСѓСЃРє СЌС‚Рѕ РїРµСЂРµСЃС‚Р°Р»Рѕ Р±С‹С‚СЊ РјРµР»РѕС‡СЊСЋ: СЃС‚РѕР»СЊРєРѕ Р¶Рµ РІРµСЃРёС‚ Рё
      РєР°Р¶РґРѕРµ РѕР±РЅРѕРІР»РµРЅРёРµ, РїРѕРјРЅРѕР¶РµРЅРЅРѕРµ РЅР° С‚СЂРёРґС†Р°С‚СЊ РјР°С€РёРЅ.
    -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Р’РµСЂСЃРёСЏ РѕРґРЅР° РЅР° РІСЃС‘ СЂРµС€РµРЅРёРµ. РњРµРЅСЏРµС‚СЃСЏ СЂРµР»РёР·РЅС‹Рј СЃРєСЂРёРїС‚РѕРј, СЂСѓРєР°РјРё вЂ” РЅРµ
    С‚СЂРѕРіР°С‚СЊ: РІ РѕСЂРёРіРёРЅР°Р»Рµ СЂСѓС‡РЅРѕР№ РІС‹РїСѓСЃРє РёР· РґРµСЃСЏС‚Рё С€Р°РіРѕРІ СЂР°РЅРѕ РёР»Рё РїРѕР·РґРЅРѕ
    РІС‹РїСѓСЃРєР°Р»СЃСЏ Р±РµР· РѕРґРЅРѕРіРѕ РёР· РЅРёС…, Рё РѕР±С‹С‡РЅРѕ СЌС‚Рѕ Р±С‹Р»Р° РІРµСЂСЃРёСЏ.
  -->
  <PropertyGroup>
    <Version>0.1.52</Version>
    <Company>EliteSIP</Company>
    <Product>EliteSIP</Product>
  </PropertyGroup>

</Project>
